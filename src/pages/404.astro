---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const REDIRECTS: Record<string, string> = {
  "/frontend/2023/11/11/frontend-weekly-digest-45.html": "/blog/2023-11-11-frontend-weekly-digest-45/",
  "/frontend/2023/11/17/frontend-weekly-digest-46.html": "/blog/2023-11-17-frontend-weekly-digest-46/",
  "/frontend/2023/11/24/frontend-weekly-digest-47.html": "/blog/2023-11-24-frontend-weekly-digest-47/",
  "/frontend/2023/12/01/frontend-weekly-digest-48.html": "/blog/2023-12-01-frontend-weekly-digest-48/",
  "/frontend/2023/12/08/frontend-weekly-digest-49.html": "/blog/2023-12-08-frontend-weekly-digest-49/",
  "/frontend/2023/12/15/frontend-weekly-digest-50.html": "/blog/2023-12-15-frontend-weekly-digest-50/",
  "/frontend/2024/01/04/frontend-weekly-digest-1.html": "/blog/2024-01-04-frontend-weekly-digest-1/",
  "/frontend/2024/01/12/frontend-weekly-digest-2.html": "/blog/2024-01-12-frontend-weekly-digest-2/",
  "/frontend/2024/02/05/frontend-weekly-digest-5.html": "/blog/2024-02-05-frontend-weekly-digest-5/",
  "/frontend/2024/02/19/frontend-weekly-digest-7.html": "/blog/2024-02-19-frontend-weekly-digest-7/",
  "/frontend/2024/03/04/frontend-weekly-digest-9.html": "/blog/2024-03-04-frontend-weekly-digest-9/",
  "/frontend/2024/03/15/frontend-weekly-digest-11.html": "/blog/2024-03-15-frontend-weekly-digest-11/",
  "/frontend/2024/03/29/frontend-weekly-digest-13.html": "/blog/2024-03-29-frontend-weekly-digest-13/",
  "/hr/2023/12/18/curiosity-beyond-technical-expertise.html": "/blog/2023-12-18-curiosity-beyond-technical-expertise/",
};
---

<Layout title="Page not found" description="The page you're looking for doesn't exist." noindex>
  <!-- The layout renders the single h1; this page only offers ways forward -->
  <div class="not-found l-reading">
    <p class="not-found__lead">The path you seek does not exist.</p>
    <p class="not-found__message">Like a stone garden raked clean, this page holds nothing — yet the journey here was not wasted.</p>
    <div class="not-found__actions">
      <a href="/blog/" class="not-found__link not-found__link--primary">
        <Icon name="book" size={16} color="currentColor" aria-hidden={true} />
        Browse reflections
      </a>
      <button type="button" class="not-found__link" data-not-found-search>
        <Icon name="search" size={16} color="currentColor" aria-hidden={true} />
        Search
      </button>
      <a href="/" class="not-found__link">
        <Icon name="home" size={16} color="currentColor" aria-hidden={true} />
        Return home
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ REDIRECTS }}>
    const path = globalThis.location.pathname;
    if (REDIRECTS[path]) {
      globalThis.location.href = REDIRECTS[path];
    }
  </script>

  <script>
    // Reuse the header's search overlay rather than wiring a second one
    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest("[data-not-found-search]")) {
        document.querySelector<HTMLElement>(".header__search-toggle")?.click();
      }
    });
  </script>
</Layout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 40vh;
    gap: 0.75rem;
    padding-block: 1rem 2rem;
  }

  .not-found__lead {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--heading-color);
    margin: 0;
  }

  .not-found__message {
    color: var(--text-secondary);
    max-width: 32rem;
    margin: 0;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .not-found__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--primary-color) 30%, transparent);
    background: color-mix(in oklch, var(--primary-color) 8%, transparent);
    color: var(--link-color-secondary);
    font: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--zen-duration-fast) var(--zen-ease-out),
      background-color var(--zen-duration-fast) var(--zen-ease-out);
  }

  .not-found__link--primary {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: var(--text-on-dark);
  }

  .not-found__link:hover {
    transform: translateY(-1px);
  }

  .not-found__link:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  .not-found__link:focus-visible {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__link {
      transition: none;
    }

    .not-found__link:hover,
    .not-found__link:active {
      transform: none;
    }
  }
</style>
