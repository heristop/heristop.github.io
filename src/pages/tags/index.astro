---
import { getPublishedPosts } from "../../utils/posts";
import { isDigest } from "../../utils/blog-index";
import { byEssays, tagStats } from "../../utils/tag-index";
import Layout from "../../layouts/Layout.astro";
import ZenSlide from "../../components/zen/ZenSlide.astro";
import ZenTagIndex from "../../components/client/zen-tag-index";
import { SITE_LANGUAGE, WEBSITE_ID, absoluteUrl } from "../../structured-data";

const posts = await getPublishedPosts();
const stats = tagStats(posts).toSorted(byEssays);
const digestCount = posts.filter(isDigest).length;

const TAGS_DESCRIPTION =
  "Browse every Zazen Code article by topic: AI agents, Claude, MCP, frontend, JavaScript, Rust, Symfony and more, with the number of posts under each tag.";
const tagsSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": absoluteUrl("/tags/"),
  url: absoluteUrl("/tags/"),
  name: "Blog topics and tags",
  description: TAGS_DESCRIPTION,
  inLanguage: SITE_LANGUAGE,
  isPartOf: { "@id": WEBSITE_ID },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: stats.length,
    itemListElement: stats
      .toSorted((statA, statB) => statA.tag.localeCompare(statB.tag))
      .map(({ tag }, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: absoluteUrl(`/tags/${tag}/`),
        name: tag,
      })),
  },
};
---

<Layout title="Tags" metaTitle="Blog Topics and Tags | Zazen Code" description={TAGS_DESCRIPTION} headSchema={tagsSchema}>
  <ZenSlide direction="up" delay={200} className="l-wide">
    <ZenTagIndex client:load tags={stats} totalPosts={posts.length} totalDigests={digestCount} />
  </ZenSlide>
</Layout>
