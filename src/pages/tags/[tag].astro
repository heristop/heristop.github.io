---
import BlogIndex from "../../components/BlogIndex.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Layout from "../../layouts/Layout.astro";
import ZenSlide from "../../components/zen/ZenSlide.astro";
import { getPublishedPosts } from "../../utils/posts";
import { isDigest } from "../../utils/blog-index";
import { dateSpan, nextTag, relatedTags, tagStats } from "../../utils/tag-index";
import { SITE_AUTHOR } from "../../consts";
import { collectionPage } from "../../structured-data";

export const getStaticPaths = async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags ?? []));
  return [...tags].map((tag) => ({ params: { tag }, props: { tag } }));
};

interface Props {
  tag: string;
}

const { tag } = Astro.props;

const allPosts = await getPublishedPosts();
const posts = allPosts
  .filter((post) => (post.data.tags ?? []).includes(tag))
  .toSorted((postA, postB) => (postB.data.pubDate?.valueOf() ?? 0) - (postA.data.pubDate?.valueOf() ?? 0));

const plural = (count: number, one: string, many = `${one}s`) => `${count} ${count === 1 ? one : many}`;

// Count and span said once, under the name; essays and digests apart only when both are here
const digestCount = posts.filter(isDigest).length;
const essayCount = posts.length - digestCount;
const span = dateSpan(posts);
const countLine =
  digestCount > 0 && essayCount > 0
    ? `${plural(essayCount, "essay")} and ${plural(digestCount, "weekly digest")}`
    : plural(posts.length, "post");

const stats = tagStats(allPosts);
const related = relatedTags(allPosts, tag);
const next = nextTag(stats, tag);
const nextCount = next ? (next.essays > 0 ? plural(next.essays, "essay") : plural(next.posts, "post")) : "";

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Tags", url: "/tags/" },
  { name: tag, url: `/tags/${tag}/` },
];

// Built from the posts themselves so each tag page gets a distinct snippet, cut on a word
// boundary to stay inside the ~160 characters a result shows
const DESCRIPTION_BUDGET = 158;
const describeTag = () => {
  const noun = posts.length === 1 ? "article" : "articles";
  const lead = `${posts.length} ${noun} by ${SITE_AUTHOR} on ${tag}: `;
  const full = lead + posts.map((post) => post.data.title).join(" · ");
  if (full.length <= DESCRIPTION_BUDGET) {
    return full;
  }
  return `${full.slice(0, DESCRIPTION_BUDGET - 1).replace(/[\s·:,;]+\S*$/, "")}…`;
};
const tagDescription = describeTag();
const tagSchema = collectionPage({
  path: `/tags/${tag}/`,
  name: `Posts tagged ${tag}`,
  description: tagDescription,
  posts,
});
---

<Layout title={tag} metaTitle={`Posts tagged ${tag} | Zazen Code`} description={tagDescription} headSchema={tagSchema}>
  <BreadcrumbSchema slot="head" items={breadcrumbItems} />
  <a slot="eyebrow" href="/tags/" class="tag-page__back"><span class="tag-page__arrow" aria-hidden="true">←</span> All tags</a>

  <BlogIndex posts={posts} excludeTag={tag} tagLimit={3} class="l-wide tag-page">
    <ZenSlide slot="head" direction="up" delay={200} className="blog-index__head">
      <p class="blog-index__intro">
        {countLine}{span && <><span class="blog-index__sep" aria-hidden="true">·</span>{span}</>}
      </p>
    </ZenSlide>
  </BlogIndex>

  <footer class="tag-page__onward l-wide" data-scroll-reveal-group>
    <hr />
    {related.length > 0 && (
      <section class="tag-page__related" aria-labelledby="often-with">
        <h2 id="often-with" class="tag-page__label">Often with {tag}</h2>
        <ul class="tag-page__related-list">
          {related.map((item) => (
            <li>
              <a class="tag-page__related-link" href={`/tags/${item.tag}/`}>
                {item.tag}<span class="tag-page__related-count"><span class="sr-only">, </span>{item.count}<span class="sr-only"> {item.count === 1 ? "post" : "posts"} together</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <nav class="tag-page__next" aria-label="More tags">
      {next && (
        <a class="tag-page__next-link" href={`/tags/${next.tag}/`}>
          <span class="tag-page__label">Next</span>
          <span class="tag-page__next-name">{next.tag}</span>
          <span class="tag-page__next-count">{nextCount}</span>
        </a>
      )}
      <a class="tag-page__all" href="/tags/">All {stats.length} tags <span class="tag-page__arrow" aria-hidden="true">→</span></a>
    </nav>
  </footer>
</Layout>
