---
import BlogIndex from "../components/BlogIndex.astro";
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
import ZenSlide from "../components/zen/ZenSlide.astro";
import { getPublishedPosts } from "../utils/posts";
import { isDigest } from "../utils/blog-index";
import { collectionPage } from "../structured-data";

const allPosts = await getPublishedPosts();
const posts = allPosts.toSorted(
  (postA, postB) => (postB.data.pubDate?.valueOf() ?? 0) - (postA.data.pubDate?.valueOf() ?? 0)
);

const BLOG_DESCRIPTION =
  "Every article by Alexandre Mogère since 2014: AI coding agents, frontend engineering, JavaScript, TypeScript, Rust and PHP, from weekly digests to case studies.";
const blogSchema = collectionPage({
  path: "/blog/",
  name: "Zazen Code blog archive",
  description: BLOG_DESCRIPTION,
  posts,
});

const digestCount = posts.filter(isDigest).length;
const essayCount = posts.length - digestCount;
const firstYear = posts.at(-1)?.data.pubDate?.getUTCFullYear();

const plural = (count: number, one: string, many = `${one}s`) => `${count} ${count === 1 ? one : many}`;

const FILTERS = [
  { value: "all", label: "All", count: posts.length },
  { value: "essay", label: "Essays", count: essayCount },
  { value: "digest", label: "Digests", count: digestCount },
] as const;
---

<Layout title="All Posts" metaTitle="Blog: Coding & AI Articles by Alexandre Mogère" description={BLOG_DESCRIPTION} headSchema={blogSchema}>
  <BlogIndex posts={posts} class="l-wide" data-blog-index="">
    <ZenSlide slot="head" direction="up" delay={200} className="blog-index__head">
      <p class="blog-index__intro">
        {plural(essayCount, "essay")} and {plural(digestCount, "weekly digest")}{firstYear && ` since ${firstYear}`}
        <span class="blog-index__links">
          <span class="blog-index__sep" aria-hidden="true">·</span>
          <button
            type="button"
            class="blog-index__link blog-index__rss"
            data-url="/rss.xml"
            aria-label="Copy RSS feed address"
            data-tooltip="Copy feed address"
          >RSS<span class="blog-index__rss-glyph" data-feedback-default><Icon name="copy" size={13} color="currentColor" aria-hidden={true} /></span><span class="blog-index__rss-glyph" data-feedback-done hidden><Icon name="check" size={13} color="currentColor" aria-hidden={true} /></span></button>
          <span class="blog-index__sep" aria-hidden="true">·</span>
          <a class="blog-index__link" href="/tags/">Tags</a>
        </span>
      </p>

      <!-- Needs script to act: html.js is set in the head, so the control is either there from the
           first paint or never (no layout shift, and no dead buttons without JS) -->
      <div class="index-seg" role="group" aria-label="Show posts">
        {FILTERS.map((filter) => (
          <button
            type="button"
            class="index-seg__option"
            data-filter-value={filter.value}
            aria-pressed={filter.value === "all" ? "true" : "false"}
          >{filter.label} <span class="index-seg__count">{filter.count}</span></button>
        ))}
      </div>
    </ZenSlide>
  </BlogIndex>

  <button
    class="scroll-to-top"
    aria-label="Scroll to top"
    data-tooltip="↑ Back to top"
    data-tooltip-placement="left"
    data-scroll-top-fixed
    hidden
  >
    <Icon name="arrow-up" size={18} aria-hidden={true} />
  </button>

  <script>
    import { announce, copyWithFeedback, ensureLiveRegion } from "../components/client/feedback";
    import { mountSegmentedGlides } from "../components/client/segmented-glide";
    import { settleScrollReveal } from "../components/client/scroll-reveal";

    type Filter = "all" | "essay" | "digest";

    // ?show=essays survives a visit to an article and back, and can be shared
    const PARAM = "show";
    const TO_PARAM: Record<Filter, string | undefined> = { all: undefined, essay: "essays", digest: "digests" };
    const FROM_PARAM: Record<string, Filter> = { essays: "essay", digests: "digest" };

    const initRssCopy = () => {
      for (const btn of document.querySelectorAll<HTMLButtonElement>(".blog-index__rss")) {
        if (btn.dataset.initialized === "true") {
          continue;
        }
        btn.dataset.initialized = "true";
        ensureLiveRegion();
        btn.addEventListener("click", () => {
          const url = new URL(btn.dataset.url ?? "/rss.xml", globalThis.location.origin).href;
          void copyWithFeedback(btn, url);
        });
      }
    };

    const initFilter = () => {
      const root = document.querySelector<HTMLElement>("[data-blog-index]");
      if (!root || root.dataset.filterReady === "true") {
        return;
      }
      root.dataset.filterReady = "true";

      const options = [...root.querySelectorAll<HTMLButtonElement>("[data-filter-value]")];
      const folds = [...root.querySelectorAll<HTMLDetailsElement>("[data-digest-fold]")];
      const countFor = (value: Filter) =>
        options.find((option) => option.dataset.filterValue === value)
          ?.querySelector(".index-seg__count")?.textContent ?? "";

      const apply = (value: Filter, fromUser: boolean) => {
        const previous = root.dataset.filter as Filter | undefined;
        root.dataset.filter = value;
        for (const option of options) {
          option.setAttribute("aria-pressed", String(option.dataset.filterValue === value));
        }

        // Digests open their folds; leaving the view closes only the folds it opened
        for (const fold of folds) {
          if (value === "digest" && !fold.open) {
            fold.open = true;
            fold.dataset.autoOpen = "true";
          } else if (value !== "digest" && fold.dataset.autoOpen === "true") {
            fold.open = false;
            delete fold.dataset.autoOpen;
          }
        }

        if (!fromUser || previous === value) {
          return;
        }
        // Rows coming back fade in place instead of replaying the page entrance, and rows still
        // waiting for their scroll entrance are simply there
        root.dataset.filtered = "true";
        settleScrollReveal(root);
        const url = new URL(globalThis.location.href);
        const param = TO_PARAM[value];
        if (param) {
          url.searchParams.set(PARAM, param);
        } else {
          url.searchParams.delete(PARAM);
        }
        history.replaceState(history.state, "", url);
        const label = value === "all" ? "all posts" : value === "essay" ? "essays" : "weekly digests";
        announce(`Showing ${countFor(value)} ${label}`);
      };

      root.addEventListener("click", (event) => {
        const option = (event.target as Element | null)?.closest<HTMLButtonElement>("[data-filter-value]");
        if (option) {
          apply((option.dataset.filterValue as Filter | undefined) ?? "all", true);
        }
      });

      const initial = FROM_PARAM[new URL(globalThis.location.href).searchParams.get(PARAM) ?? ""];
      if (initial) {
        ensureLiveRegion();
        apply(initial, false);
      }
    };

    let teardownGlide: (() => void) | undefined;

    const init = () => {
      initRssCopy();
      initFilter();
      teardownGlide?.();
      teardownGlide = mountSegmentedGlides();
    };

    init();
    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", () => {
      teardownGlide?.();
      teardownGlide = undefined;
    });
  </script>
</Layout>
