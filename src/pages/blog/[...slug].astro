---
import "katex/dist/katex.min.css";
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BlogPostSchema from "../../components/BlogPostSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Icon from "../../components/Icon.astro";
import Layout from "../../layouts/Layout.astro";
import PostTags from "../../components/client/PostTags";
import RecommendedPosts from "../../components/RecommendedPosts.astro";
import SocialShare from "../../components/SocialShare.astro";
import { BUY_ME_COFFEE_URL } from "../../consts";

const currentPostSlug = Astro.props.id;

export const getStaticPaths = async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
};
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
const {conclusion} = post.data;

const plainText = post.body ?? "";
const WORDS_PER_MINUTE = 200;
const words = plainText.split(/\s+/).length;
const readingTime = Math.ceil(words / WORDS_PER_MINUTE);

const allPostsCollection = await getCollection("blog");
const allPosts = allPostsCollection.toSorted(
  (postA, postB) => (postB.data.pubDate?.valueOf() ?? 0) - (postA.data.pubDate?.valueOf() ?? 0)
);

const currentIndex = allPosts.findIndex(item => item.id === currentPostSlug);

let previousPost;
if (currentIndex < allPosts.length - 1) {
  previousPost = allPosts[currentIndex + 1];
}

let nextPost;
if (currentIndex > 0) {
  nextPost = allPosts[currentIndex - 1];
}

const postUrl = `https://heristop.github.io/blog/${currentPostSlug}/`;

const postData = {
  ...post.data,
  isArticle: true,
  readingTime,
  tags: post.data.tags,
};

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: post.data.title, url: postUrl },
];
---

<BlogPostSchema
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  image={post.data.image}
  url={postUrl}
/>
<BreadcrumbSchema items={breadcrumbItems} />

<Layout {...postData}>
  <div class="post-page">
    <div class="post-page__meta zen-stagger">
      <div class="post-page__meta-info">
        <div class="post-page__date">
          <Icon name="calendar" size={16} class="post-page__date-icon" aria-hidden={true} />
          {post.data.pubDate && (
            <span
              class="post-page__date-text"
              transition:name={`post-date-${post.id}`}
            >
              <FormattedDate date={post.data.pubDate} showYear />
            </span>
          )}
        </div>
        <div class="post-page__reading-time">
          <Icon name="book" size={16} class="post-page__reading-icon" aria-hidden={true} />
          <span>{readingTime} min read</span>
        </div>
      </div>
      <div class="post-page__share">
        <SocialShare
          class="post-page__share-links"
          title={post.data.title}
          slug={currentPostSlug}
          minimal
        />
      </div>
    </div>

    {post.data.tags && post.data.tags.length > 0 && (
      <div class="post-page__tags-slot" transition:name={`post-tags-${post.id}`}>
        <PostTags client:load tags={post.data.tags} />
      </div>
    )}

    <Content />

    <div class="post-page__share-bottom">
      <SocialShare
        class="post-page__share-links"
        title={post.data.title}
        slug={currentPostSlug}
        supportUrl={BUY_ME_COFFEE_URL}
      />
    </div>

    <blockquote class="post-page__endquote">
      <RecommendedPosts {currentPostSlug} {conclusion} />
    </blockquote>
  </div>

  <div class="reading-progress" aria-hidden="true"></div>
  <button
    class="scroll-to-top"
    aria-label="Scroll to top"
    data-tooltip="↑ Back to top"
    data-tooltip-placement="left"
    data-scroll-top-fixed
    hidden
  >
    <Icon name="arrow-up" size={18} aria-hidden={true} />
  </button>

  <div
    class="post-nav-data"
    hidden
    data-previous-id={previousPost?.id}
    data-previous-title={previousPost?.data.title}
    data-next-id={nextPost?.id}
    data-next-title={nextPost?.data.title}
  ></div>
  <script>
    // Bundled once and re-initialised on every page load; each page's listeners are torn down
    // before the next swap so client-side navigation never stacks handlers.
    interface NavPost {
      id: string;
      title: string;
    }
    type Direction = "previous" | "next";

    const NAVIGATION_DELAY = 150;
    const HINT_FADE_DELAY = 300;
    const HINT_DISPLAY_DURATION = 1000;
    const TABLET_BREAKPOINT = 1024;
    const SWIPE_THRESHOLD = 100;
    const SWIPE_TIMEOUT = 500;
    const VERTICAL_THRESHOLD = 50;

    const isTouchDevice = "ontouchstart" in globalThis || navigator.maxTouchPoints > 0;
    const shouldUseTouchNavigation = () =>
      isTouchDevice && globalThis.innerWidth <= TABLET_BREAKPOINT;

    const readPost = (data: DOMStringMap, key: "previous" | "next"): NavPost | undefined => {
      const id = data[`${key}Id`];
      const title = data[`${key}Title`];
      return id && title ? { id, title } : undefined;
    };

    const escapeAttribute = (value: string) => value.replaceAll('"', "&quot;");

    const showNavigationHint = (direction: Direction, targetPost: NavPost | undefined) => {
      const hint = document.createElement("div");
      hint.className = `navigation-hint navigation-hint--${direction}`;
      hint.setAttribute("role", "status");
      hint.setAttribute("aria-live", "polite");

      const label = document.createElement("span");
      label.className = "navigation-hint__label";
      label.textContent = direction === "previous" ? "\u2190 Previous" : "Next \u2192";
      hint.append(label);

      if (targetPost) {
        const title = document.createElement("span");
        title.className = "navigation-hint__title";
        title.textContent = targetPost.title;
        hint.append(title);
      }

      document.body.append(hint);
      requestAnimationFrame(() => {
        hint.style.opacity = "0.88";
        hint.style.transform = "translate(-50%, -50%)";
      });
      setTimeout(() => {
        hint.style.opacity = "0";
        hint.style.transform = "translate(-50%, -50%) translateY(-10px)";
        setTimeout(() => {
          hint.remove();
        }, HINT_FADE_DELAY);
      }, HINT_DISPLAY_DURATION);
    };

    const buildIndicatorButtons = (
      previousPost: NavPost | undefined,
      nextPost: NavPost | undefined,
      shouldUseTouch: boolean,
    ) => {
      const arrows: string[] = [];
      if (previousPost) {
        const title = escapeAttribute(previousPost.title);
        arrows.push(`
          <a
            class="post-nav-indicator post-nav-indicator--left"
            href="/blog/${previousPost.id}/"
            data-tooltip="\u2190 ${title}"
            data-tooltip-placement="left"
            aria-label="Previous post: ${title}"
          >\u2190</a>
        `);
      }
      if (nextPost) {
        const title = escapeAttribute(nextPost.title);
        arrows.push(`
          <a
            class="post-nav-indicator post-nav-indicator--right"
            href="/blog/${nextPost.id}/"
            data-tooltip="${title} \u2192"
            data-tooltip-placement="left"
            aria-label="Next post: ${title}"
          >\u2192</a>
        `);
      }
      if (arrows.length === 0) {
        return "";
      }
      const hintText = shouldUseTouch
        ? "Swipe left/right to navigate reflections"
        : "Use \u2190 \u2192 keys to navigate reflections";
      return `<div class="post-nav-arrows">${arrows.join("")}</div>
        <span class="post-nav-hint" role="status" aria-live="polite">${hintText}</span>`;
    };

    const isEditable = (element: Element | null) =>
      element instanceof HTMLElement &&
      (element.tagName === "INPUT" ||
        element.tagName === "TEXTAREA" ||
        element.tagName === "SELECT" ||
        element.isContentEditable);

    const initPostNavigation = (
      previousPost: NavPost | undefined,
      nextPost: NavPost | undefined,
      signal: AbortSignal,
    ) => {
      document.querySelector(".post-navigation-indicators")?.remove();
      document.querySelector(".global-navigation-indicators")?.remove();
      if (!previousPost && !nextPost) {
        return;
      }

      const navigateToPost = (direction: Direction) => {
        const targetPost = direction === "previous" ? previousPost : nextPost;
        if (!targetPost) {
          return;
        }
        showNavigationHint(direction, targetPost);
        setTimeout(() => {
          globalThis.location.href = `/blog/${targetPost.id}/`;
        }, NAVIGATION_DELAY);
      };

      const useTouch = shouldUseTouchNavigation();
      if (useTouch) {
        let touchStartX = 0;
        let touchStartY = 0;
        let touchStartTime = 0;
        document.addEventListener(
          "touchstart",
          (event) => {
            const touch = event.touches[0];
            if (isEditable(document.activeElement) || !touch) {
              return;
            }
            touchStartX = touch.clientX;
            touchStartY = touch.clientY;
            touchStartTime = Date.now();
          },
          { passive: true, signal },
        );
        document.addEventListener(
          "touchend",
          (event) => {
            const touch = event.changedTouches[0];
            if (isEditable(document.activeElement) || !touchStartX || !touch) {
              return;
            }
            const deltaX = touch.clientX - touchStartX;
            const deltaY = Math.abs(touch.clientY - touchStartY);
            const timeDelta = Date.now() - touchStartTime;
            touchStartX = 0;
            if (
              Math.abs(deltaX) <= SWIPE_THRESHOLD ||
              deltaY >= VERTICAL_THRESHOLD ||
              timeDelta >= SWIPE_TIMEOUT
            ) {
              return;
            }
            if (deltaX > 0 && previousPost) {
              event.preventDefault();
              navigateToPost("previous");
            } else if (deltaX < 0 && nextPost) {
              event.preventDefault();
              navigateToPost("next");
            }
          },
          { passive: false, signal },
        );
      } else {
        document.addEventListener(
          "keydown",
          (event) => {
            if (
              isEditable(document.activeElement) ||
              event.ctrlKey ||
              event.metaKey ||
              event.altKey ||
              event.shiftKey
            ) {
              return;
            }
            if (event.key === "ArrowLeft" && previousPost) {
              event.preventDefault();
              navigateToPost("previous");
            } else if (event.key === "ArrowRight" && nextPost) {
              event.preventDefault();
              navigateToPost("next");
            }
          },
          { signal },
        );
      }

      const indicators = document.createElement("div");
      indicators.className = "post-navigation-indicators";
      indicators.setAttribute("role", "region");
      indicators.setAttribute("aria-label", "Blog post navigation");
      indicators.innerHTML = buildIndicatorButtons(previousPost, nextPost, useTouch);
      document.body.append(indicators);
    };

    const initReadingProgress = (signal: AbortSignal) => {
      const bar = document.querySelector<HTMLElement>(".reading-progress");
      if (!bar) {
        return;
      }
      const stickyNav = document.querySelector("#sticky-nav");
      if (stickyNav) {
        stickyNav.append(bar);
      } else {
        bar.classList.add("reading-progress--fixed");
      }

      // Scroll height only changes on resize/content growth, so it is not read on every scroll
      let scrollable = 0;
      const measure = () => {
        scrollable = document.documentElement.scrollHeight - globalThis.innerHeight;
      };
      let frame = 0;
      const paint = () => {
        frame = 0;
        const progress = scrollable > 0 ? Math.min(globalThis.scrollY / scrollable, 1) : 0;
        bar.style.transform = `scaleX(${progress})`;
      };
      const schedule = () => {
        frame ||= requestAnimationFrame(paint);
      };

      const observer = new ResizeObserver(() => {
        measure();
        schedule();
      });
      observer.observe(document.body);
      globalThis.addEventListener("scroll", schedule, { passive: true, signal });
      signal.addEventListener("abort", () => {
        observer.disconnect();
        cancelAnimationFrame(frame);
      });
      measure();
      paint();
    };

    const scrollToHash = () => {
      const { hash } = globalThis.location;
      if (!hash) {
        return;
      }
      const target = document.querySelector(hash);
      if (target) {
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: "smooth" });
        });
      }
    };

    let pageEvents: AbortController | undefined;

    document.addEventListener("astro:page-load", () => {
      pageEvents?.abort();
      const data = document.querySelector<HTMLElement>(".post-nav-data")?.dataset;
      if (!data) {
        pageEvents = undefined;
        return;
      }
      pageEvents = new AbortController();
      const { signal } = pageEvents;
      initPostNavigation(readPost(data, "previous"), readPost(data, "next"), signal);
      initReadingProgress(signal);
      scrollToHash();
    });

    document.addEventListener("astro:before-swap", () => {
      pageEvents?.abort();
      pageEvents = undefined;
    });
  </script>
</Layout>
