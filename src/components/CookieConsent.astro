---
// Consent bar for Google Analytics. BaseHead.astro sets Consent Mode to denied and defines
// loadGoogleAnalytics() but never calls gtag.js; Accept here is the only thing that loads it, so a
// visitor who declines generates no requests to Google at all.
//
// Rendered on every page but hidden by default via the `hidden` attribute. The inline script below
// reveals it only when no choice is stored — the reverse (render visible, hide with JS) makes the bar
// flash on every page load for visitors who already decided, which is worse than not having one.
---

<div
  id="cookie-consent"
  class="consent"
  role="region"
  aria-label="Analytics consent"
  hidden
>
  <p class="consent__text">
    A light touch — which pages are read, and where readers arrive from. Nothing is
    sent unless you allow it.
  </p>

  <div class="consent__actions">
    <button type="button" class="consent__btn consent__btn--ghost" data-consent="denied">
      Decline
    </button>
    <button type="button" class="consent__btn consent__btn--solid" data-consent="granted">
      Accept
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "heristop-consent";
    var bar = document.getElementById("cookie-consent");
    if (!bar) return;

    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {
      // Storage blocked: a choice can't be remembered, so asking every visit would be the only
      // honest option — but a bar that never goes away is worse. Stay silent and stay denied.
      return;
    }

    if (stored === "granted" || stored === "denied") return;

    bar.hidden = false;
    // Two frames: one to let `hidden` drop, one so the transition has a start state to animate from.
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        bar.classList.add("is-visible");
      });
    });

    bar.addEventListener("click", function (event) {
      var choice = event.target.closest("[data-consent]");
      if (!choice) return;

      var value = choice.getAttribute("data-consent");
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {
        /* nothing to do — the update below still applies for this pageview */
      }

      if (value === "granted") {
        if (typeof window.gtag === "function") {
          window.gtag("consent", "update", { analytics_storage: "granted" });
        }
        // gtag.js is not on the page until this point — declining leaves zero Google requests.
        if (typeof window.loadGoogleAnalytics === "function") {
          window.loadGoogleAnalytics();
        }
      }

      bar.classList.remove("is-visible");
      // Match the CSS duration so the node leaves the a11y tree only after it's out of sight.
      window.setTimeout(function () {
        bar.hidden = true;
      }, 280);
    });
  })();
</script>

<style>
  .consent {
    position: fixed;
    right: var(--space-ml);
    bottom: var(--space-ml);
    left: var(--space-ml);
    z-index: 100;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-ml);
    align-items: center;
    justify-content: space-between;
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-ml) var(--space-lg);
    border-radius: var(--radius-lg);

    /* A translucent layer the page scrolls under, not an opaque strip that eats a band of the
       viewport. No scrim: this is a parallel, non-blocking ask — dimming the page would imply the
       reader has to deal with it before continuing, which is not true. */
    background: color-mix(in oklch, var(--primary-bg-color) 78%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid color-mix(in oklch, var(--primary-color) 16%, transparent);
    /* Bright top edge: light catching the near side of a real material. */
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0deg / 55%),
      var(--home-card-shadow-soft);
    will-change: transform, opacity, backdrop-filter;

    /* Materialises rather than fading: blur, scale and position resolve together, so it reads as a
       surface arriving instead of a rectangle turning opaque. Enters up from the bottom edge and
       leaves the same way — a thing that appeared from below belongs below. */
    transform: translateY(1rem) scale(0.985);
    opacity: 0;
    transition:
      opacity var(--zen-transition-duration) var(--zen-ease-elegant),
      transform var(--zen-transition-duration) var(--zen-ease-spring),
      backdrop-filter var(--zen-transition-duration) var(--zen-ease-elegant);
  }

  .consent.is-visible {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  /* Vibrancy: text over a translucent surface needs more contrast and a touch more weight than the
     same text on a solid one — flat grey goes muddy as whatever is behind it changes. The small
     positive tracking is size-specific; it buys legibility at 0.875rem and would look loose larger. */
  .consent__text {
    flex: 1 1 22rem;
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.005em;
    color: var(--heading-color);
  }

  .consent__actions {
    display: flex;
    flex: 0 0 auto;
    gap: var(--space-md);
  }

  .consent__btn {
    /* 44px min target: this is the one interaction on the page everyone is forced to make. */
    min-height: 44px;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-md);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--zen-duration-fast) var(--zen-ease-out),
      border-color var(--zen-duration-fast) var(--zen-ease-out),
      transform var(--zen-duration-fast) var(--zen-ease-out);
  }

  .consent__btn:focus-visible {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  .consent__btn:hover {
    transform: translateY(-1px);
  }

  /* Feedback on the press itself, not on release. Waiting for click to acknowledge reads as dead. */
  .consent__btn:active {
    transform: scale(0.97);
    transition: transform 100ms var(--zen-ease-out);
  }

  /* Decline is a peer, not a footnote: same size and same hit area as Accept, because a refusal that
     is harder to give than a consent is not a real choice. Only the fill differs. */
  .consent__btn--ghost {
    border: 1px solid color-mix(in oklch, var(--primary-color) 34%, transparent);
    background: transparent;
    color: var(--primary-color);
  }

  .consent__btn--ghost:hover {
    background: color-mix(in oklch, var(--primary-color) 8%, transparent);
  }

  .consent__btn--solid {
    border: 1px solid var(--primary-color);
    background: var(--primary-color);
    color: oklch(99% 0.005 75deg);
  }

  .consent__btn--solid:hover {
    background: var(--link-hover-color);
    border-color: var(--link-hover-color);
  }

  @media screen and (width < 40rem) {
    .consent {
      gap: var(--space-md);
    }

    .consent__actions {
      flex: 1 1 100%;
    }

    .consent__btn {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Reduced motion is not "no feedback": keep a short cross-fade, drop the travel and the scale. */
    .consent {
      transform: none;
      transition: opacity 200ms var(--zen-ease-out);
    }

    .consent.is-visible {
      transform: none;
    }

    .consent__btn:hover,
    .consent__btn:active {
      transform: none;
    }
  }

  /* Frost the material instead of blurring it — the effect people are asking to be rid of is the
     see-through, not the panel. */
  @media (prefers-reduced-transparency: reduce) {
    .consent {
      background: var(--primary-bg-color);
      backdrop-filter: none;
    }
  }

  /* Near-solid with a defined edge, so the boundary never depends on a shadow being perceptible. */
  @media (prefers-contrast: more) {
    .consent {
      background: var(--primary-bg-color);
      backdrop-filter: none;
      border-color: var(--primary-color);
    }

    .consent__text {
      color: var(--heading-color);
      font-weight: 600;
    }
  }
</style>
