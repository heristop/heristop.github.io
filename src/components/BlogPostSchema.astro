---
import { SITE_LANGUAGE, WEBSITE_ID, absoluteUrl, person } from '../structured-data';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  image?: string;
  url: string;
  tags?: string[];
  wordCount?: number;
}

const { title, description, pubDate, updatedDate, image, url, tags = [], wordCount } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  author: person,
  dateModified: (updatedDate ?? pubDate)?.toISOString(),
  datePublished: pubDate?.toISOString(),
  description: description,
  headline: title,
  // Same fallback as og:image, so a post without a cover still qualifies for article rich results
  image: absoluteUrl(image ?? '/images/og-zazen.webp'),
  inLanguage: SITE_LANGUAGE,
  isPartOf: { '@id': WEBSITE_ID },
  keywords: tags.length > 0 ? tags.join(', ') : undefined,
  mainEntityOfPage: {
    '@id': url,
    '@type': 'WebPage',
  },
  // A personal blog: the author is the publisher. Google accepts a Person here.
  publisher: { '@id': person['@id'], '@type': 'Person', name: person.name, url: person.url },
  url: url,
  wordCount,
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
