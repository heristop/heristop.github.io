---
import LucideIcon from "@zazencode/ui/icon";
import type { IconName } from "@zazencode/ui/icon-registry";

export interface Props {
  name: IconName;
  size?: number;
  color?: string;
  class?: string;
  'aria-label'?: string;
  'aria-hidden'?: boolean;
  role?: 'img' | 'presentation' | 'none';
}

const { class: className, color = "var(--primary-color)", ...props } = Astro.props;
---

<LucideIcon {...props} className={className} color={color} />
