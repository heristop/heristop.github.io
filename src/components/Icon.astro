---
import LucideIcon from "./client/icon";
import type { IconName } from "./icon-registry";

export interface Props {
  name: IconName;
  size?: number;
  color?: string;
  class?: string;
  'aria-label'?: string;
  'aria-hidden'?: boolean;
  role?: 'img' | 'presentation' | 'none';
}

const { class: className, color = "var(--primary-color)", ...props } = Astro.props;
---

<LucideIcon {...props} className={className} color={color} />

<style is:global>
  .icon { display: inline-block; vertical-align: middle; flex-shrink: 0; }
</style>
