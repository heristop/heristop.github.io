---
import '../styles/global.scss';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  image?: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title,
  metaTitle,
  description,
  image = '/images/og-zazen.webp',
  isArticle = false,
  pubDate,
  updatedDate,
  tags,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font Preload -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{metaTitle ?? title}</title>
<meta name="title" content={metaTitle ?? title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={metaTitle ?? title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{isArticle && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{isArticle && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{isArticle && (
  <meta property="article:author" content="Alexandre Mogère" />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={metaTitle ?? title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:creator" content="@heristop" />

{isArticle && tags && tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!--
  Google Analytics 4, loaded only after consent.

  gtag.js is NOT requested here. Consent Mode alone is not enough: with analytics_storage denied the
  tag still sends a cookieless ping — no cookies or identifier, but page, referrer and coarse geo do
  leave the browser. That makes "nothing is collected unless you say yes" untrue, so instead the
  library is injected by loadGoogleAnalytics(), called only when consent exists. Declining means zero
  requests to Google, which is a claim that needs no footnote.

  The consent defaults and config still run now: gtag() queues into dataLayer, and the library
  replays that queue when it eventually loads.
-->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;

  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
  });

  gtag("js", new Date());
  gtag("config", "G-P44DRVCNGY", { anonymize_ip: true });

  // Idempotent: CookieConsent.astro calls this on Accept, and it runs here on load for a visitor
  // who already accepted, so their pageview is measured rather than lost.
  window.loadGoogleAnalytics = function () {
    if (document.getElementById("ga-tag")) return;
    var tag = document.createElement("script");
    tag.id = "ga-tag";
    tag.async = true;
    tag.src = "https://www.googletagmanager.com/gtag/js?id=G-P44DRVCNGY";
    document.head.appendChild(tag);
  };

  try {
    if (localStorage.getItem("heristop-consent") === "granted") {
      gtag("consent", "update", { analytics_storage: "granted" });
      window.loadGoogleAnalytics();
    }
  } catch (e) {
    /* storage blocked — stay denied and load nothing */
  }
</script>
