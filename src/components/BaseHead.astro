---
// Self-hosted fonts keep the plain family names that the CSS and pretext's canvas strings use
import '@fontsource/comfortaa/400.css';
import '@fontsource/comfortaa/500.css';
import '@fontsource/comfortaa/600.css';
import '@fontsource/comfortaa/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '@fontsource/jetbrains-mono/500-italic.css';
import comfortaaRegular from '@fontsource/comfortaa/files/comfortaa-latin-400-normal.woff2?url';
import comfortaaBold from '@fontsource/comfortaa/files/comfortaa-latin-700-normal.woff2?url';
import '../styles/global.scss';
import GardenTransition from './GardenTransition.astro';
import PageMotion from './PageMotion.astro';
import InkReveal from './InkReveal.astro';
import { cloudflareToken } from '../analytics';
import { THEME_STORAGE_KEY } from './client/theme-preference';
import { READER_FONT_KEY, READER_SIZES, READER_SIZE_KEY } from './client/reader-preference';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolved on the build machine: the page carries the beacon, or carries nothing.
const cloudflare = cloudflareToken();

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  image?: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Keeps the page out of the index (404, utility pages); its links are still followed */
  noindex?: boolean;
}

const {
  title,
  metaTitle,
  description,
  image = '/images/og-zazen.webp',
  isArticle = false,
  pubDate,
  updatedDate,
  tags,
  noindex = false,
} = Astro.props;

// A post's cover is the header banner, its LCP element: fetch it with the fonts instead of after
// the stylesheet. The default banner is a responsive srcset the <img> already prioritises.
const bannerPreload = isArticle ? Astro.props.image : undefined;

// The site name goes after the page name when it still fits the ~60 characters a result shows;
// a long post title keeps the room for itself. An explicit metaTitle is used as written.
const BRAND_SUFFIX = ` | ${SITE_TITLE}`;
const TITLE_BUDGET = 60;
const pageTitle =
  metaTitle ??
  (title.includes(SITE_TITLE) || title.length + BRAND_SUFFIX.length > TITLE_BUDGET
    ? title
    : `${title}${BRAND_SUFFIX}`);
const socialTitle = metaTitle ?? title;
const imageURL = new URL(image, Astro.site);
const imageAlt = isArticle ? `Cover image for “${title}”` : `${SITE_TITLE}, a zen garden of code`;
---

<!-- Global Metadata: the charset stays within the first 1024 bytes of the document -->
<meta charset="utf-8" />
<!-- viewport-fit=cover: the page runs under the notch and home indicator; env(safe-area-inset-*)
     keeps the fixed chrome, the menu sheet and the gutters clear of them -->
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />

<GardenTransition />
<PageMotion />
<InkReveal />
<!-- Light paper by default; the theme boot below switches both when Dark or System is chosen -->
<meta name="color-scheme" content="light" />
<!-- Night garden: browser chrome takes the sticky bar's ink instead of a default grey -->
<meta name="theme-color" content="#21181c" media="not all" />

<!--
  Theme boot: runs before first paint, so a chosen garden never flashes the other one. Mirrors
  readThemePreference + applyThemePreference in client/theme-preference.ts. A client-side swap
  replaces <html> attributes and these metas, so the choice is stamped onto the incoming
  document before the swap and re-applied after it.
-->
<script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
  var read = function () {
    try {
      var value = localStorage.getItem(storageKey);
      return value === "dark" || value === "system" ? value : "light";
    } catch (e) {
      return "light";
    }
  };
  var apply = function (doc) {
    var preference = read();
    doc.documentElement.setAttribute("data-theme", preference);
    var scheme = doc.querySelector('meta[name="color-scheme"]');
    if (scheme) scheme.setAttribute("content", preference === "system" ? "light dark" : preference);
    var chrome = doc.querySelector('meta[name="theme-color"]');
    if (chrome) {
      chrome.setAttribute(
        "media",
        preference === "dark" ? "all" : preference === "light" ? "not all" : "(prefers-color-scheme: dark)",
      );
    }
  };
  apply(document);
  if (!window.__themeBoot) {
    window.__themeBoot = true;
    document.addEventListener("astro:before-swap", function (event) {
      apply(event.newDocument);
    });
    document.addEventListener("astro:after-swap", function () {
      apply(document);
    });
  }
</script>

<!--
  Reader boot: an article's text size and legible face, stamped on <html> before first paint so
  the prose never reflows once it shows. Mirrors readReaderPreferences + applyReaderPreferences in
  client/reader-preference.ts; only `.post-page` reads the attributes, so other pages ignore them.
-->
<script is:inline define:vars={{ sizeKey: READER_SIZE_KEY, fontKey: READER_FONT_KEY, sizes: READER_SIZES }}>
  (function () {
    var apply = function (doc) {
      var size = "";
      var font = "";
      try {
        var stored = Number(localStorage.getItem(sizeKey));
        if (stored !== 100 && sizes.indexOf(stored) !== -1) size = String(stored);
        if (localStorage.getItem(fontKey) === "legible") font = "legible";
      } catch (e) {
        /* storage blocked: the defaults */
      }
      var root = doc.documentElement;
      if (size) root.setAttribute("data-reader-size", size);
      else root.removeAttribute("data-reader-size");
      if (font) root.setAttribute("data-reader-font", font);
      else root.removeAttribute("data-reader-font");
    };
    apply(document);
    if (!window.__readerBoot) {
      window.__readerBoot = true;
      document.addEventListener("astro:before-swap", function (event) {
        apply(event.newDocument);
      });
      document.addEventListener("astro:after-swap", function () {
        apply(document);
      });
    }
  })();
</script>

<!--
  Daypart: the banner takes a faint wash at dawn and dusk, by the visitor's own clock. Stamped
  before first paint so it never pops in; mirrors daypartFor in client/daypart.ts. Only the very
  first load fades it in; client-side swaps carry it over as it is.
-->
<script is:inline>
  (function () {
    var part = function () {
      var hour = new Date().getHours();
      return hour >= 5 && hour < 9 ? "dawn" : hour >= 17 && hour < 20 ? "dusk" : "";
    };
    var apply = function (doc) {
      var value = part();
      if (value) doc.documentElement.setAttribute("data-daypart", value);
      else doc.documentElement.removeAttribute("data-daypart");
    };
    apply(document);
    if (!window.__daypartBoot) {
      window.__daypartBoot = true;
      document.documentElement.setAttribute("data-daypart-fade", "");
      document.addEventListener("astro:before-swap", function (event) {
        apply(event.newDocument);
      });
      document.addEventListener("astro:after-swap", function () {
        apply(document);
      });
    }
  })();
</script>

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font Preload: body and title weights, the rest load on demand -->
<link rel="preload" href={comfortaaRegular} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={comfortaaBold} as="font" type="font/woff2" crossorigin />
{bannerPreload && <link rel="preload" href={bannerPreload} as="image" fetchpriority="high" />}

<!-- Canonical URL: a noindexed page (404) must not claim a URL of its own -->
{!noindex && <link rel="canonical" href={canonicalURL} />}
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
{isArticle && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{isArticle && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{isArticle && (
  <meta property="article:author" content={SITE_AUTHOR} />
)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@heristop" />
<meta name="twitter:creator" content="@heristop" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

{isArticle && tags && tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!--
  Google Analytics is gone, and the consent bar with it — but not from the browsers of visitors who
  had already accepted. They keep `_ga` cookies Google set, and a stored yes nothing asks about any
  more, with no bar left to withdraw either from. Clearing them is the visitor's side of that
  removal, so it happens here rather than nowhere. Safe to delete once the cookies it clears have
  expired on their own.
-->
<script is:inline>
  (function () {
    try {
      if (localStorage.getItem("heristop-consent") !== null) {
        localStorage.removeItem("heristop-consent");
      }
    } catch (e) {
      /* storage blocked — nothing was stored to clear either */
    }

    // GA sets these on the exact host and, depending on the property, on a dot-prefixed parent;
    // a cookie only expires when the domain and path match the ones it was written with.
    var stale = document.cookie.split(";").map(function (pair) {
      return pair.split("=")[0].trim();
    });

    for (var i = 0; i < stale.length; i++) {
      if (!/^_ga($|_)|^_gid$/.test(stale[i])) continue;
      document.cookie = stale[i] + "=; Max-Age=0; path=/";
      document.cookie = stale[i] + "=; Max-Age=0; path=/; domain=" + location.hostname;
      document.cookie = stale[i] + "=; Max-Age=0; path=/; domain=." + location.hostname;
    }
  })();
</script>

<!--
  Cloudflare Web Analytics, the only tracker this site carries. Cookieless — nothing is written on
  the visitor's device — which is why no consent bar is rendered anywhere: there is no question to
  ask. It collects page views on its own and has no event API, so nothing else can be measured
  through it. Unset the token and the site ships no tag at all.
-->
{cloudflare && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cloudflare })}></script>
)}

