---
import '../styles/global.scss';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  image?: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title,
  metaTitle,
  description,
  image = '/images/og-zazen.webp',
  isArticle = false,
  pubDate,
  updatedDate,
  tags,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font Preload -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{metaTitle ?? title}</title>
<meta name="title" content={metaTitle ?? title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={metaTitle ?? title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{isArticle && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{isArticle && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{isArticle && (
  <meta property="article:author" content="Alexandre Mogère" />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={metaTitle ?? title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:creator" content="@heristop" />

{isArticle && tags && tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!--
  Google Analytics 4, gated behind Consent Mode v2.

  Order matters and is the whole point: the `consent default` call must run BEFORE gtag.js is
  requested, so the tag boots with storage denied and sends nothing until the visitor opts in.
  CookieConsent.astro flips it with a `consent update`. Getting this backwards means the first
  pageview is collected before anyone agrees to anything, which is the failure mode Consent Mode
  exists to prevent.
-->
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;

  gtag("consent", "default", {
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
    analytics_storage: "denied",
    wait_for_update: 500,
  });

  // Replay a stored choice before the tag loads, so a returning visitor who already accepted is
  // measured on their first pageview rather than from the second one on.
  try {
    if (localStorage.getItem("heristop-consent") === "granted") {
      gtag("consent", "update", { analytics_storage: "granted" });
    }
  } catch (e) {
    /* storage blocked — stay denied */
  }

  gtag("js", new Date());
  gtag("config", "G-P44DRVCNGY", { anonymize_ip: true });
</script>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P44DRVCNGY"></script>
