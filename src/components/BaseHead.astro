---
import '../styles/global.scss';
import { analyticsMode, umamiConfig } from '../analytics';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolved on the build machine, so the page ships one tracker's tag and nothing of the other's.
const tracker = analyticsMode();
const umami = umamiConfig();

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  image?: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title,
  metaTitle,
  description,
  image = '/images/og-zazen.webp',
  isArticle = false,
  pubDate,
  updatedDate,
  tags,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font Preload -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{metaTitle ?? title}</title>
<meta name="title" content={metaTitle ?? title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={metaTitle ?? title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{isArticle && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{isArticle && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{isArticle && (
  <meta property="article:author" content="Alexandre Mogère" />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={metaTitle ?? title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:creator" content="@heristop" />

{isArticle && tags && tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!--
  Self-hosted Umami. It sets no cookie and stores no visitor identifier, so it needs no consent gate
  and none is rendered: the bar and the footer's shortcut are both absent from this build.

  Auto-tracking stays on. The first pageview is the tag's own; <ClientRouter> then navigates without
  reloading and Astro does not re-run an already-executed inline script, so the ones after it come
  from the tracker's own history hook rather than from anything here.
-->
{tracker === 'umami' && umami && (
  <script is:inline async src={umami.scriptSrc} data-website-id={umami.websiteId} data-host-url={umami.hostUrl}></script>
)}

<!--
  Switching a live site over leaves the previous tracker's traces in browsers that already accepted:
  a stored yes nothing asks about any more, and Google's cookies with no bar left to withdraw them
  from. Clearing them is the visitor's side of the switch, so it happens here rather than nowhere.
-->
{tracker === 'umami' && (
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem("heristop-consent") !== null) {
          localStorage.removeItem("heristop-consent");
        }
      } catch (e) {
        /* storage blocked — nothing was stored to clear either */
      }

      // GA sets these on the exact host and, depending on the property, on a dot-prefixed parent;
      // a cookie only expires when the domain and path match the ones it was written with.
      var stale = document.cookie.split(";").map(function (pair) {
        return pair.split("=")[0].trim();
      });

      for (var i = 0; i < stale.length; i++) {
        if (!/^_ga($|_)|^_gid$/.test(stale[i])) continue;
        document.cookie = stale[i] + "=; Max-Age=0; path=/";
        document.cookie = stale[i] + "=; Max-Age=0; path=/; domain=" + location.hostname;
        document.cookie = stale[i] + "=; Max-Age=0; path=/; domain=." + location.hostname;
      }
    })();
  </script>
)}

<!--
  Google Analytics 4, loaded only after consent.

  gtag.js is NOT requested here. Consent Mode alone is not enough: with analytics_storage denied the
  tag still sends a cookieless ping — no cookies or identifier, but page, referrer and coarse geo do
  leave the browser. That makes "nothing is collected unless you say yes" untrue, so instead the
  library is injected by loadGoogleAnalytics(), called only when consent exists. Declining means zero
  requests to Google, which is a claim that needs no footnote.

  The consent defaults and config still run now: gtag() queues into dataLayer, and the library
  replays that queue when it eventually loads.

  Absent entirely from an Umami build — that is what lets the bar go with it.
-->
{tracker === 'ga' && (
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;

    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
    });

    gtag("js", new Date());
    gtag("config", "G-P44DRVCNGY", { anonymize_ip: true });

    // Idempotent: CookieConsent.astro calls this on Accept, and it runs here on load for a visitor
    // who already accepted, so their pageview is measured rather than lost.
    window.loadGoogleAnalytics = function () {
      if (document.getElementById("ga-tag")) return;
      var tag = document.createElement("script");
      tag.id = "ga-tag";
      tag.async = true;
      tag.src = "https://www.googletagmanager.com/gtag/js?id=G-P44DRVCNGY";
      document.head.appendChild(tag);
    };

    try {
      if (localStorage.getItem("heristop-consent") === "granted") {
        gtag("consent", "update", { analytics_storage: "granted" });
        window.loadGoogleAnalytics();
      }
    } catch (e) {
      /* storage blocked — stay denied and load nothing */
    }
  </script>
)}
