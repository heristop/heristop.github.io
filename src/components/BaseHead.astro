---
import '../styles/global.scss';
import { cloudflareToken } from '../analytics';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolved on the build machine: the page carries the beacon, or carries nothing.
const cloudflare = cloudflareToken();

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  image?: string;
  isArticle?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title,
  metaTitle,
  description,
  image = '/images/og-zazen.webp',
  isArticle = false,
  pubDate,
  updatedDate,
  tags,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Font Preload -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{metaTitle ?? title}</title>
<meta name="title" content={metaTitle ?? title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={metaTitle ?? title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />
{isArticle && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{isArticle && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{isArticle && (
  <meta property="article:author" content="Alexandre Mogère" />
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={metaTitle ?? title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
<meta name="twitter:creator" content="@heristop" />

{isArticle && tags && tags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!--
  Google Analytics is gone, and the consent bar with it — but not from the browsers of visitors who
  had already accepted. They keep `_ga` cookies Google set, and a stored yes nothing asks about any
  more, with no bar left to withdraw either from. Clearing them is the visitor's side of that
  removal, so it happens here rather than nowhere. Safe to delete once the cookies it clears have
  expired on their own.
-->
<script is:inline>
  (function () {
    try {
      if (localStorage.getItem("heristop-consent") !== null) {
        localStorage.removeItem("heristop-consent");
      }
    } catch (e) {
      /* storage blocked — nothing was stored to clear either */
    }

    // GA sets these on the exact host and, depending on the property, on a dot-prefixed parent;
    // a cookie only expires when the domain and path match the ones it was written with.
    var stale = document.cookie.split(";").map(function (pair) {
      return pair.split("=")[0].trim();
    });

    for (var i = 0; i < stale.length; i++) {
      if (!/^_ga($|_)|^_gid$/.test(stale[i])) continue;
      document.cookie = stale[i] + "=; Max-Age=0; path=/";
      document.cookie = stale[i] + "=; Max-Age=0; path=/; domain=" + location.hostname;
      document.cookie = stale[i] + "=; Max-Age=0; path=/; domain=." + location.hostname;
    }
  })();
</script>

<!--
  Cloudflare Web Analytics, the only tracker this site carries. Cookieless — nothing is written on
  the visitor's device — which is why no consent bar is rendered anywhere: there is no question to
  ask. It collects page views on its own and has no event API, so nothing else can be measured
  through it. Unset the token and the site ships no tag at all.
-->
{cloudflare && (
  <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cloudflare })}></script>
)}

