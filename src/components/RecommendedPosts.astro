---
import FormattedDate from './FormattedDate.astro';
import Icon from './Icon.astro';
import { getPublishedPosts } from '../utils/posts';

const { currentPostSlug, excludeSlugs = [] } = Astro.props;
const excludedIds = new Set([currentPostSlug, ...excludeSlugs]);
const recommendedPosts = (await getPublishedPosts())
  .filter(post => !excludedIds.has(post.id))
  .sort((postA, postB) => (postB.data.pubDate?.valueOf() ?? 0) - (postA.data.pubDate?.valueOf() ?? 0))
  .slice(0, 3);
---

{recommendedPosts.length > 0 && (
  <section class="recommended-posts" data-scroll-reveal="fade">
    <hr class="recommended-posts__divider" />
    <nav aria-labelledby="recommended-posts-heading">
      <div class="recommended-posts__header">
        <h2 class="recommended-posts__heading" id="recommended-posts-heading">Keep reading</h2>
        <a class="recommended-posts__all" href="/blog/">
          All articles <Icon name="arrow-right" size={14} color="currentColor" aria-hidden={true} />
        </a>
      </div>
      <ul>
        {recommendedPosts.map(post => (
          <li class="recommended-posts__item">
            <a class="recommended-posts__link" href={`/blog/${post.id}/`}>
              <span class="recommended-posts__text">
                <span class="recommended-posts__title">{post.data.title}</span>
                {post.data.pubDate && <span class="recommended-posts__date"><FormattedDate date={post.data.pubDate} showYear /></span>}
              </span>
              {post.data.image && (
                <span class="recommended-posts__media">
                  <img
                    class="recommended-posts__image"
                    src={post.data.image}
                    alt=""
                    width="96"
                    height="64"
                    loading="lazy"
                    decoding="async"
                    style={post.data.bannerPosition ? `object-position: ${post.data.bannerPosition}` : undefined}
                  />
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
)}
