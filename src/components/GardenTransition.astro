<script>
  import type {
    TransitionBeforePreparationEvent,
    TransitionBeforeSwapEvent,
  } from "astro:transitions/client";

  const isGarden = (url: URL) => /^\/path-of-stones\/?$/.test(url.pathname);
  let navigation = 0;

  document.addEventListener("astro:before-preparation", (event) => {
    const next = event as TransitionBeforePreparationEvent;
    const id = ++navigation;
    const entering = isGarden(next.to);
    const crossing = entering !== isGarden(next.from);
    const root = document.documentElement;
    delete root.dataset.gardenTransition;
    if (!crossing) return;

    const direction = entering ? "enter" : "leave";
    // Keyboard and browser-history navigation open from the same calm focal point.
    const bounds = next.sourceElement?.getBoundingClientRect();
    const x = bounds ? bounds.left + bounds.width / 2 : innerWidth / 2;
    const y = bounds ? bounds.top + bounds.height / 2 : innerHeight * 0.4;
    const origin = `${Math.round(x)}px ${Math.round(y)}px`;
    const radius = `${Math.ceil(Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y)))}px`;
    const prepare = next.loader;
    next.loader = async () => {
      await prepare();
      if (next.signal.aborted || next.defaultPrevented || navigation !== id) return;
      if (!entering) next.newDocument.documentElement.dataset.gardenReturn = "";
      for (const element of [root, next.newDocument.documentElement]) {
        element.dataset.gardenTransition = direction;
        element.style.setProperty("--garden-portal-origin", origin);
        element.style.setProperty("--garden-portal-radius", radius);
      }
    };
  });

  document.addEventListener("astro:before-swap", (event) => {
    const swap = event as TransitionBeforeSwapEvent;
    const id = navigation;
    if (!swap.newDocument.documentElement.dataset.gardenTransition) return;
    const clear = () => {
      if (id !== navigation) return;
      const root = document.documentElement;
      delete root.dataset.gardenTransition;
      root.style.removeProperty("--garden-portal-origin");
      root.style.removeProperty("--garden-portal-radius");
    };
    void swap.viewTransition.finished.then(clear, clear);
  });
</script>

<style is:global>
  /* The returning page is already revealed; do not replay its delayed entrance. */
  html[data-garden-return] :is(.zen-fade, .zen-slide-up, .zen-slide-down, .zen-slide-left, .zen-slide-right, .zen-scale),
  html[data-garden-return] .zen-stagger > * {
    animation-delay: -3s !important;
  }

  html[data-garden-return] .latest-posts__title span {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
    animation: none !important;
    transition: none !important;
  }

  /* A single scene snapshot keeps headers, petals and the board moving together. */
  html[data-garden-transition] * {
    view-transition-name: none !important;
  }

  html[data-garden-transition]::view-transition-group(root) {
    animation: none;
    isolation: isolate;
  }

  html[data-garden-transition]::view-transition-old(root),
  html[data-garden-transition]::view-transition-new(root) {
    mix-blend-mode: normal;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transform-origin: var(--garden-portal-origin);
  }

  html[data-garden-transition="enter"]::view-transition-old(root) {
    animation: garden-step-away 720ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  html[data-garden-transition="enter"]::view-transition-new(root) {
    animation: garden-portal-open 820ms cubic-bezier(0.76, 0, 0.24, 1) both;
    z-index: 2;
  }

  html[data-garden-transition="leave"]::view-transition-old(root) {
    animation: garden-portal-close 700ms cubic-bezier(0.76, 0, 0.24, 1) both;
    z-index: 2;
  }

  html[data-garden-transition="leave"]::view-transition-new(root) {
    animation: garden-return 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes garden-portal-open {
    from { clip-path: circle(0 at var(--garden-portal-origin)); }
    to { clip-path: circle(var(--garden-portal-radius) at var(--garden-portal-origin)); }
  }

  @keyframes garden-portal-close {
    from { clip-path: circle(var(--garden-portal-radius) at var(--garden-portal-origin)); }
    to { clip-path: circle(0 at var(--garden-portal-origin)); }
  }

  @keyframes garden-step-away {
    to { transform: scale(0.97); filter: brightness(0.65); }
  }

  @keyframes garden-return {
    from { transform: scale(1.025); filter: brightness(0.85); }
    to { transform: scale(1); filter: brightness(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-garden-transition]::view-transition-old(root),
    html[data-garden-transition]::view-transition-new(root) {
      animation: none !important;
    }
  }
</style>
