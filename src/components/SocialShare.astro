---
import Icon from "./Icon.astro";
interface Props {
  title: string;
  slug: string;
  minimal?: boolean;
  class?: string;
  /** When provided, append a "Buy me a coffee" CTA after the share links. */
  supportUrl?: string;
}

const {
  title,
  slug,
  minimal = false,
  class: className = 'social-share--default',
  supportUrl,
} = Astro.props;
const url = `https://heristop.github.io/blog/${slug}`;

const shareLinks = [
  {
    icon: 'bluesky', name: 'Bluesky', url: `https://bsky.app/intent/compose?text=${encodeURIComponent(title)}%20${encodeURIComponent(url)}`,
  },
  {
    icon: 'x-twitter', name: 'X', url: `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
  },
  {
    icon: 'linkedin', name: 'LinkedIn', url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  },
];
---

<div class={`social-share ${className}`}>
  {supportUrl && (
    <a
      href={supportUrl}
      target="_blank"
      rel="noopener noreferrer"
      class:list={[
        'social-share__link',
        'social-share__link--support',
        minimal ? 'social-share__link--minimal' : 'social-share__link--full',
      ]}
      aria-label="Support my writing — Buy me a coffee"
      data-tooltip={minimal ? 'Buy me a coffee ☕' : 'Support my writing ☕ (opens in new tab)'}
    >
      <span class="social-share__link--support-shimmer" aria-hidden="true" />
      <Icon name="coffee" size={20} color="currentColor" aria-hidden={true}
        class={`social-share__icon ${!minimal ? 'social-share__icon--with-text' : ''}`} />
      {!minimal && (
        <span class="social-share__text">Buy me a coffee</span>
      )}
    </a>
  )}
  {
    shareLinks.map(link => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class:list={[
          'social-share__link',
          minimal ? 'social-share__link--minimal' : 'social-share__link--full',
        ]}
        aria-label={minimal ? `Share on ${link.name}` : undefined}
        data-tooltip={minimal ? `Share on ${link.name}` : "Opens in new tab"}
      >
        <img
          src={`/icons/${link.icon}.svg`}
          alt=""
          width="20"
          height="20"
          class:list={[
            'social-share__icon',
            { 'social-share__icon--with-text': !minimal },
          ]}
        />
        {!minimal && (
          <span class="social-share__text">Share on {link.name}</span>
        )}
      </a>
    ))
  }
  <button
    type="button"
    class:list={[
      'social-share__link',
      'social-share__native-btn',
      minimal ? 'social-share__link--minimal' : 'social-share__link--full',
    ]}
    data-share-title={title}
    data-share-url={url}
    aria-label={minimal ? 'Share' : undefined}
    data-tooltip={minimal ? 'Share' : 'Share via system dialog or copy link'}
    hidden
  >
    <span data-share-default>
      <Icon name="share-2" size={20} color="currentColor" aria-hidden={true}
        class={`social-share__icon ${!minimal ? 'social-share__icon--with-text' : ''}`} />
    </span>
    <span data-share-confirmed hidden>
      <Icon name="check" size={20} color="currentColor" aria-hidden={true}
        class={`social-share__icon ${!minimal ? 'social-share__icon--with-text' : ''}`} />
    </span>
    {!minimal && (
      <span class="social-share__text">Share</span>
    )}
  </button>
</div>

<script>
  const SHARE_FEEDBACK_DURATION = 1500;

  const initSocialShare = () => {
    const canShare = typeof navigator.share !== 'undefined';
    const canCopy =
      typeof navigator.clipboard !== 'undefined' &&
      typeof navigator.clipboard.writeText !== 'undefined';

    for (const el of document.querySelectorAll('.social-share__native-btn')) {
      if (!(el instanceof HTMLElement)) {
        continue;
      }
      const btn = el;

      if (canShare || canCopy) {
        btn.removeAttribute('hidden');
      }

      if (btn.dataset.initialized === 'true') {
        continue;
      }
      btn.dataset.initialized = 'true';

      btn.addEventListener('click', async () => {
        const title = btn.getAttribute('data-share-title') ?? '';
        const url = btn.getAttribute('data-share-url') ?? '';

        if (canShare) {
          try {
            await navigator.share({ title, url });
          } catch {
            // Ignore share errors (e.g. user cancelled)
          }
          return;
        }

        if (!canCopy) {
          return;
        }

        await navigator.clipboard.writeText(url);
        const regular = btn.querySelector<HTMLElement>('[data-share-default]');
        const confirmed = btn.querySelector<HTMLElement>('[data-share-confirmed]');
        if (!regular || !confirmed) return;
        regular.hidden = true;
        confirmed.hidden = false;
        setTimeout(() => {
          regular.hidden = false;
          confirmed.hidden = true;
        }, SHARE_FEEDBACK_DURATION);
      });
    }
  };

  initSocialShare();
  document.addEventListener('astro:page-load', initSocialShare);
</script>
