---
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getImage } from 'astro:assets';
import { imageMetadata } from 'astro/assets/utils';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { SITE_TITLE } from '../consts';
import zazenBanner from '../assets/zazen.webp';

const { image, bannerPosition } = Astro.props;

// The painting is the LCP element: serve a width that fits the viewport instead of the full source.
// Mirrors .site-header__banner: 85% of the header container (867px once the layout caps at 65em),
// gutter to gutter on phones.
const BANNER_SIZES = '(min-width: 65em) 867px, (min-width: 48rem) calc(85vw - 1.0625rem), calc(100vw - 3.25rem)';
const responsiveBanner = image
  ? undefined
  : await getImage({ src: zazenBanner, widths: [480, 768, 1024, 1536], format: 'webp' });

// A post's banner fills the same band as the site banner (cropped, bannerPosition picks the focus);
// its intrinsic size lets the browser decode it at the right aspect before layout
const readPostBannerSize = async (src: string): Promise<{ width?: number; height?: number }> => {
  if (!src.startsWith('/')) {
    return {};
  }
  try {
    const { width, height } = await imageMetadata(await readFile(join(process.cwd(), 'public', src)), src);
    return { width, height };
  } catch {
    return {};
  }
};
const postBanner = image ? { src: image, ...(await readPostBannerSize(image)) } : undefined;

const title = `{ ${SITE_TITLE.replace(' ', '_')} }`;
---

<!-- Static Header with Banner -->
<header class="site-header-static">
  <div class="site-header__container">
    <div class="header__brand-section">
      <div class="site-header__title title">
        <a href="/" aria-label={`${SITE_TITLE}, home`}>{title}</a>
      </div>
    </div>

    <!-- Initial Navigation (visible immediately) -->
    <nav
      class="header__nav-initial"
      aria-label="Main navigation"
    >
      <div class="header__nav-links">
        <!-- Desktop Navigation -->
        <div
          class="header__nav header__nav--desktop"
          id="initial-nav"
        >
          <span class="header__nav-highlight" aria-hidden="true"></span>
          <HeaderLink class="header__link" href="/"
            >Home</HeaderLink
          >
          <HeaderLink class="header__link" href="/blog"
            >Blog</HeaderLink
          >
          <HeaderLink class="header__link" href="/projects"
            >Projects</HeaderLink
          >
          <HeaderLink class="header__link" href="/about"
            >About</HeaderLink
          >
          <HeaderLink class="header__link" href="/path-of-stones"
            >Garden</HeaderLink
          >
        </div>

        <!-- Search and Mobile Menu Actions -->
        <div class="header__actions">
          <!-- Search Button -->
          <button
            class="header__search-toggle"
            aria-label="Toggle search"
            aria-expanded="false"
            type="button"
          >
            <Icon name="search" size={20} aria-hidden={true} />
          </button>

          <ThemeToggle id="initial" />

          <!-- Mobile Menu Toggle -->
          <button
            class="header__mobile-toggle"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="initial-mobile-nav"
            type="button"
          >
            <span class="header__hamburger"></span>
            <span class="header__hamburger"></span>
            <span class="header__hamburger"></span>
          </button>
        </div>

        <!-- Mobile Navigation -->
        <div
          class="header__nav header__nav--mobile"
          id="initial-mobile-nav"
        >
          <!-- Grabber of the phone bottom sheet: drag it down, or press it, to close -->
          <button class="header__sheet-handle" type="button" aria-label="Close menu"></button>
          <HeaderLink
            class="header__link header__link--mobile"
            href="/">Home</HeaderLink
          >
          <HeaderLink
            class="header__link header__link--mobile"
            href="/blog">Blog</HeaderLink
          >
          <HeaderLink
            class="header__link header__link--mobile"
            href="/projects">Projects</HeaderLink
          >
          <HeaderLink
            class="header__link header__link--mobile"
            href="/about">About</HeaderLink
          >
          <HeaderLink
            class="header__link header__link--mobile"
            href="/path-of-stones">Garden</HeaderLink
          >
        </div>
      </div>
    </nav>

    {postBanner ? (
      <figure class="banner site-header__banner site-header__banner--post" id="header-banner">
        <div class="site-header__banner-container">
          <img
            src={postBanner.src}
            alt=""
            role="presentation"
            class="site-header__banner-image"
            style={bannerPosition ? `object-position: ${bannerPosition}` : undefined}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width={postBanner.width}
            height={postBanner.height}
          />
        </div>
      </figure>
    ) : (
      <figure class="banner site-header__banner" id="header-banner">
        <div class="site-header__banner-container">
          <picture class="site-header__banner-picture">
            <source
              srcset={responsiveBanner?.srcSet.attribute}
              sizes={BANNER_SIZES}
              type="image/webp"
            />
            <img
              src="/images/zazen.png"
              alt=""
              role="presentation"
              class="site-header__banner-image"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="1536"
              height="900"
            />
          </picture>
          <div class="site-header__banner-overlay" aria-hidden="true"></div>
        </div>
      </figure>
    )}
  </div>
</header>

<!-- Sticky Navigation Bar -->
<nav
  class="site-header-nav"
  id="sticky-nav"
  aria-label="Main navigation"
>
  <div class="site-header-nav__container">
    <div class="header__nav-content">
      <div class="header__brand-mini">
        <a href="/" class="header__brand-link" aria-label={`${SITE_TITLE}, home`}
          >{title}</a
        >
      </div>

      <!-- Desktop Navigation -->
      <div
        class="header__nav header__nav--desktop"
        id="header-nav"
      >
        <span class="header__nav-highlight" aria-hidden="true"></span>
        <HeaderLink class="header__link" href="/"
          >Home</HeaderLink
        >
        <HeaderLink class="header__link" href="/blog"
          >Blog</HeaderLink
        >
        <HeaderLink class="header__link" href="/projects"
          >Projects</HeaderLink
        >
        <HeaderLink class="header__link" href="/about"
          >About</HeaderLink
        >
        <HeaderLink class="header__link" href="/path-of-stones"
          >Garden</HeaderLink
        >
      </div>

      <!-- Search and Mobile Menu Actions -->
      <div class="header__actions">
        <!-- Search Button -->
        <button
          class="header__search-toggle"
          aria-label="Toggle search"
          aria-expanded="false"
          type="button"
        >
          <Icon name="search" size={20} aria-hidden={true} />
        </button>

        <ThemeToggle id="sticky" />

        <!-- Mobile Menu Toggle -->
        <button
          class="header__mobile-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
          type="button"
        >
          <span class="header__hamburger"></span>
          <span class="header__hamburger"></span>
          <span class="header__hamburger"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div class="header__nav header__nav--mobile" id="mobile-nav">
      <!-- Grabber of the phone bottom sheet: drag it down, or press it, to close -->
      <button class="header__sheet-handle" type="button" aria-label="Close menu"></button>
      <HeaderLink
        class="header__link header__link--mobile"
        href="/">Home</HeaderLink
      >
      <HeaderLink
        class="header__link header__link--mobile"
        href="/blog">Blog</HeaderLink
      >
      <HeaderLink
        class="header__link header__link--mobile"
        href="/projects">Projects</HeaderLink
      >
      <HeaderLink
        class="header__link header__link--mobile"
        href="/about">About</HeaderLink
      >
      <HeaderLink
        class="header__link header__link--mobile"
        href="/path-of-stones">Garden</HeaderLink
      >
    </div>

  </div>
</nav>

<script>
  import "./client/header-init";
</script>
