          <g transform="translate(56 -24)"><g class="footer-scene__bird" style="--b: 3"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-2.7 -3.2 -6 -0.8" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q2.7 -3.2 6 -0.8" /></g></g>
          <g transform="translate(-37 -6)"><g class="footer-scene__bird" style="--b: 4"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-3.1 -3.6 -7 -0.9" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q3.1 -3.6 7 -0.9" /></g></g>
        </g>
