---
// Sumi-e landscape painted under the footer: misty ranges, a pagoda on the
// cliff, a leaning pine and a pilgrim crossing the water on a sampan. The
// painting is split into depth planes so scroll and pointer can part them.
---

<div class="footer-scene" aria-hidden="true" data-footer-scene>
  <div class="footer-scene__canvas">
    <svg
      class="footer-scene__svg footer-scene__plane footer-scene__plane--sky"
      viewBox="0 0 1200 420"
      preserveAspectRatio="xMaxYMax slice"
      focusable="false"
    >
      <defs>
        <filter id="footer-brush" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="3" seed="7" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" result="brushed" />
          <feGaussianBlur in="brushed" stdDeviation="0.5" />
        </filter>
        <filter id="footer-wash-far" x="-5%" y="-10%" width="110%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="11" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" result="washed" />
          <feGaussianBlur in="washed" stdDeviation="1.6" />
        </filter>
        <filter id="footer-wash-mid" x="-5%" y="-10%" width="110%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.024" numOctaves="2" seed="5" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" xChannelSelector="R" yChannelSelector="G" result="washed" />
          <feGaussianBlur in="washed" stdDeviation="0.9" />
        </filter>
        <filter id="footer-grain" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" />
          <feColorMatrix values="0 0 0 0 0.2  0 0 0 0 0.15  0 0 0 0 0.15  0 0 0 0.09 0" />
        </filter>

        <linearGradient id="footer-far" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.17" />
          <stop offset="0.7" style="stop-color: var(--footer-ink); stop-opacity: 0" />
        </linearGradient>
        <linearGradient id="footer-mid" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.36" />
          <stop offset="0.8" style="stop-color: var(--footer-ink); stop-opacity: 0" />
        </linearGradient>
        <linearGradient id="footer-cliff" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.84" />
          <stop offset="0.5" style="stop-color: var(--footer-ink); stop-opacity: 0.4" />
          <stop offset="1" style="stop-color: var(--footer-ink); stop-opacity: 0.06" />
        </linearGradient>
        <radialGradient id="footer-mist">
          <stop offset="0" style="stop-color: var(--primary-bg-color); stop-opacity: 0.95" />
          <stop offset="1" style="stop-color: var(--primary-bg-color); stop-opacity: 0" />
        </radialGradient>
        <linearGradient id="footer-water" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.05" />
        <stop offset="0.3" style="stop-color: var(--footer-ink); stop-opacity: 0.1" />
        <stop offset="1" style="stop-color: var(--footer-ink); stop-opacity: 0.17" />
      </linearGradient>
      <radialGradient id="footer-sun">
          <stop offset="0" style="stop-color: var(--primary-color); stop-opacity: 0.92" />
          <stop offset="0.86" style="stop-color: var(--primary-color); stop-opacity: 0.86" />
          <stop offset="1" style="stop-color: var(--primary-color); stop-opacity: 0" />
        </radialGradient>
        <radialGradient id="footer-halo">
          <stop offset="0" style="stop-color: var(--primary-color); stop-opacity: 0.2" />
          <stop offset="1" style="stop-color: var(--primary-color); stop-opacity: 0" />
        </radialGradient>

        <path id="footer-roof" d="M-30 0 Q-17 -2 -11 -9 L11 -9 Q17 -2 30 0 Q14 -3 0 -3 Q-14 -3 -30 0 Z" />
      </defs>

      <g class="footer-scene__layer footer-scene__layer--sun" style="--d: 2">
