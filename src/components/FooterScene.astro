          <path class="footer-scene__stroke footer-scene__reed" style="--w: 0" fill="none" d="M142 344 q-8 -18 -6 -34" />
          <path class="footer-scene__stroke footer-scene__reed" style="--w: 1" fill="none" d="M150 340 q-2 -26 6 -44" />
          <path class="footer-scene__stroke footer-scene__reed" style="--w: 2" fill="none" d="M160 342 q4 -22 16 -34" />
        </g>
      </g>
    </svg>
    <svg
      class="footer-scene__svg footer-scene__plane footer-scene__plane--grain"
      viewBox="0 0 1200 420"
      preserveAspectRatio="xMaxYMax slice"
      focusable="false"
    >
      <rect width="1200" height="420" filter="url(#footer-grain)" />
    </svg>
  </div>
</div>

<script is:inline>
  const initFooterScene = () => {
    const scene = document.querySelector('[data-footer-scene]');
    if (!scene || scene.dataset.footerSceneInit === 'true') return;
    scene.dataset.footerSceneInit = 'true';
    const reducedMotion = globalThis.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

    // Pointer parallax: the planes part slightly as the pointer crosses the footer.
    const footer = scene.closest('footer');
    const finePointer = globalThis.matchMedia?.('(hover: hover) and (pointer: fine)').matches;
    if (footer && finePointer && !reducedMotion) {
      let frame = 0;
      footer.addEventListener('pointermove', (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const box = footer.getBoundingClientRect();
          scene.style.setProperty('--mx', (((event.clientX - box.left) / box.width) * 2 - 1).toFixed(3));
          scene.style.setProperty('--my', (((event.clientY - box.top) / box.height) * 2 - 1).toFixed(3));
        });
      });
      footer.addEventListener('pointerleave', () => {
        scene.style.setProperty('--mx', '0');
        scene.style.setProperty('--my', '0');
      });
    }

    if (!('IntersectionObserver' in globalThis)) {
      scene.classList.add('is-awake');
      return;
    }

    // The painting inks itself in once per visit; later pages show it finished.
    const PAINTED_KEY = 'footer-scene-painted';
    let painted = true;
    try {
      painted = sessionStorage.getItem(PAINTED_KEY) === 'true';
    } catch {}
    if (!painted && !reducedMotion) scene.classList.add('is-inking');

    const observer = new IntersectionObserver(([entry]) => {
      scene.classList.toggle('is-awake', entry.isIntersecting);
      if (!entry.isIntersecting || !scene.classList.contains('is-inking')) return;
      if (scene.classList.contains('is-painted')) return;
      requestAnimationFrame(() => scene.classList.add('is-painted'));
      try {
        sessionStorage.setItem(PAINTED_KEY, 'true');
      } catch {}
    }, { threshold: 0.35 });
    observer.observe(scene);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  };
  initFooterScene();
  document.addEventListener('astro:page-load', initFooterScene);
</script>
