---
// Sumi-e landscape painted under the footer: misty ranges, a pagoda on the
// cliff, a leaning pine and a pilgrim crossing the water on a sampan. The
// painting is split into depth planes so scroll and pointer can part them.
// Brushwork comes from scripts/footer-scene/generate.mjs (pnpm generate:footer).
import strokes from "./footer-scene-strokes.json";
---

<div class="footer-scene" aria-hidden="true" data-footer-scene>
  <div class="footer-scene__canvas">
    <svg
      class="footer-scene__svg footer-scene__plane footer-scene__plane--sky"
      viewBox="0 0 1200 420"
      preserveAspectRatio="xMaxYMax slice"
      focusable="false"
    >
      <defs>
        <filter id="footer-brush" x="-5%" y="-5%" width="110%" height="110%">
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="3" seed="7" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" result="brushed" />
          <feGaussianBlur in="brushed" stdDeviation="0.5" />
        </filter>
        <filter id="footer-wash-far" x="-5%" y="-10%" width="110%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="11" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="6" xChannelSelector="R" yChannelSelector="G" result="washed" />
          <feGaussianBlur in="washed" stdDeviation="1.6" />
        </filter>
        <filter id="footer-wash-mid" x="-5%" y="-10%" width="110%" height="120%">
          <feTurbulence type="fractalNoise" baseFrequency="0.024" numOctaves="2" seed="5" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" xChannelSelector="R" yChannelSelector="G" result="washed" />
          <feGaussianBlur in="washed" stdDeviation="0.9" />
        </filter>
        <!-- Watercolor edge: pigment pools where the wash dries, so the rim reads darker. -->
        <filter id="footer-wet-edge" x="-5%" y="-10%" width="110%" height="120%">
          <feGaussianBlur in="SourceAlpha" stdDeviation="2.4" result="soft" />
          <feComposite in="SourceAlpha" in2="soft" operator="arithmetic" k2="3" k3="-3" result="rim" />
          <feFlood style="flood-color: var(--footer-ink)" flood-opacity="0.5" />
          <feComposite in2="rim" operator="in" result="ink" />
          <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="ink" /></feMerge>
        </filter>
        <filter id="footer-grain" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="3" />
          <feColorMatrix values="0 0 0 0 0.2  0 0 0 0 0.15  0 0 0 0 0.15  0 0 0 0.09 0" />
        </filter>

        <linearGradient id="footer-far" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.17" />
          <stop offset="0.7" style="stop-color: var(--footer-ink); stop-opacity: 0" />
        </linearGradient>
        <linearGradient id="footer-mid" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.36" />
          <stop offset="0.8" style="stop-color: var(--footer-ink); stop-opacity: 0" />
        </linearGradient>
        <linearGradient id="footer-cliff" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.84" />
          <stop offset="0.5" style="stop-color: var(--footer-ink); stop-opacity: 0.4" />
          <stop offset="1" style="stop-color: var(--footer-ink); stop-opacity: 0.06" />
        </linearGradient>
        <linearGradient id="footer-rock" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.95" />
          <stop offset="1" style="stop-color: var(--footer-ink); stop-opacity: 0.4" />
        </linearGradient>
        <radialGradient id="footer-mist">
          <stop offset="0" style="stop-color: var(--primary-bg-color); stop-opacity: 0.95" />
          <stop offset="1" style="stop-color: var(--primary-bg-color); stop-opacity: 0" />
        </radialGradient>
        <linearGradient id="footer-water" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style="stop-color: var(--footer-ink); stop-opacity: 0.05" />
        <stop offset="0.3" style="stop-color: var(--footer-ink); stop-opacity: 0.1" />
        <stop offset="1" style="stop-color: var(--footer-ink); stop-opacity: 0.17" />
      </linearGradient>
      <radialGradient id="footer-sun">
          <stop offset="0" style="stop-color: var(--primary-color); stop-opacity: 0.92" />
          <stop offset="0.86" style="stop-color: var(--primary-color); stop-opacity: 0.86" />
          <stop offset="1" style="stop-color: var(--primary-color); stop-opacity: 0" />
        </radialGradient>
        <radialGradient id="footer-halo">
          <stop offset="0" style="stop-color: var(--primary-color); stop-opacity: 0.2" />
          <stop offset="1" style="stop-color: var(--primary-color); stop-opacity: 0" />
        </radialGradient>

        <path id="footer-roof" d="M-30 0 Q-17 -2 -11 -9 L11 -9 Q17 -2 30 0 Q14 -3 0 -3 Q-14 -3 -30 0 Z" />
      </defs>

      <g class="footer-scene__layer footer-scene__layer--sun" style="--d: 2">
        <circle class="footer-scene__halo" cx="486" cy="212" r="78" fill="url(#footer-halo)" />
        <circle class="footer-scene__sun" cx="486" cy="212" r="31" fill="url(#footer-sun)" filter="url(#footer-wet-edge)" />
      </g>

      <g class="footer-scene__layer" style="--d: 3">
        <g class="footer-scene__birds">
          <g transform="translate(10 0)"><g class="footer-scene__bird" style="--b: 0"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-4.5 -4.8 -10 -1.2 q5.5 -1.2 10 1.2 Z" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q4.5 -4.8 10 -1.2 q-5.5 -1.2 -10 1.2 Z" /></g></g>
          <g transform="translate(34 -13)"><g class="footer-scene__bird" style="--b: 1"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-3.6 -4 -8 -1 q4.4 -1 8 1 Z" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q3.6 -4 8 -1 q-4.4 -1 -8 1 Z" /></g></g>
          <g transform="translate(-15 -18)"><g class="footer-scene__bird" style="--b: 2"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-3.1 -3.6 -7 -0.9 q3.9 -0.9 7 0.9 Z" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q3.1 -3.6 7 -0.9 q-3.9 -0.9 -7 0.9 Z" /></g></g>
          <g transform="translate(56 -24)"><g class="footer-scene__bird" style="--b: 3"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-2.7 -3.2 -6 -0.8 q3.3 -0.8 6 0.8 Z" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q2.7 -3.2 6 -0.8 q-3.3 -0.8 -6 0.8 Z" /></g></g>
          <g transform="translate(-37 -6)"><g class="footer-scene__bird" style="--b: 4"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-3.1 -3.6 -7 -0.9 q3.9 -0.9 7 0.9 Z" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q3.1 -3.6 7 -0.9 q-3.9 -0.9 -7 0.9 Z" /></g></g>
        </g>
      </g>
    </svg>
    <svg
      class="footer-scene__svg footer-scene__plane footer-scene__plane--far"
      viewBox="0 0 1200 420"
      preserveAspectRatio="xMaxYMax slice"
      focusable="false"
    >
      <g class="footer-scene__layer" style="--d: 0">
        <path
          class="footer-scene__distant"
          filter="url(#footer-wash-far) url(#footer-wet-edge)"
          d="M600 236 Q700 214 780 208 Q850 196 900 158 Q930 140 958 162 Q1000 190 1040 184 Q1080 176 1110 168 Q1150 160 1200 186 L1200 260 L600 260 Z"
        />
        <path class="footer-scene__paper" filter="url(#footer-wash-mid)" d="M0 250 Q70 214 130 222 T250 170 Q300 138 350 178 T470 196 Q540 200 600 232 Q660 252 720 226 Q790 194 860 214 Q930 234 1000 208 Q1080 184 1200 222 L1200 340 L0 340 Z" />
        <path
          fill="url(#footer-far)"
          filter="url(#footer-wash-far) url(#footer-wet-edge)"
          d="M0 250 Q70 214 130 222 T250 170 Q300 138 350 178 T470 196 Q540 200 600 232 Q660 252 720 226 Q790 194 860 214 Q930 234 1000 208 Q1080 184 1200 222 L1200 340 L0 340 Z"
        />
      </g>

      <g class="footer-scene__layer" style="--d: 2">
        <g class="footer-scene__birds footer-scene__birds--far">
          <g transform="translate(5 0)"><g class="footer-scene__bird" style="--b: 5"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-2.2 -2.4 -5 -0.6 q2.8 -0.6 5 0.6 Z" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q2.2 -2.4 5 -0.6 q-2.8 -0.6 -5 0.6 Z" /></g></g>
          <g transform="translate(18 -7)"><g class="footer-scene__bird" style="--b: 6"><path class="footer-scene__wing footer-scene__wing--left" d="M0 0 q-1.8 -2.1 -4 -0.5 q2.2 -0.55 4 0.5 Z" /><path class="footer-scene__wing footer-scene__wing--right" d="M0 0 q1.8 -2.1 4 -0.5 q-2.2 -0.55 -4 0.5 Z" /></g></g>
        </g>
      </g>

      <ellipse class="footer-scene__mist footer-scene__mist--high" cx="520" cy="238" rx="380" ry="28" fill="url(#footer-mist)" />
    </svg>
    <svg
      class="footer-scene__svg footer-scene__plane footer-scene__plane--mid"
      viewBox="0 0 1200 420"
      preserveAspectRatio="xMaxYMax slice"
      focusable="false"
    >
      <g class="footer-scene__layer" style="--d: 1">
        <path
          fill="url(#footer-mid)"
          filter="url(#footer-wash-mid)"
          d="M-20 336 Q50 300 110 270 Q160 246 196 212 Q222 188 244 190 Q268 194 292 224 Q312 246 338 250 Q362 252 384 268 Q450 300 560 330 L560 340 L-20 340 Z"
        />
        <path
          fill="url(#footer-mid)"
          filter="url(#footer-wash-mid) url(#footer-wet-edge)"
          opacity="0.7"
          d="M420 336 Q470 312 520 300 Q560 290 590 296 Q640 306 700 330 L700 340 L420 340 Z"
        />
        <!-- Cun texture laid along the ridge: the crest line lifts at the peak, the
             strokes leave it down the shaded left flank, moss dots sit on the crest. -->
        <g class="footer-scene__cun" filter="url(#footer-wash-mid)">
          {strokes.mountain.crest.map((d) => <path class="footer-scene__cun-crest" d={d} />)}
          {strokes.mountain.cun.map((d) => <path d={d} />)}
          {strokes.hill.crest.map((d) => <path class="footer-scene__cun-crest" d={d} />)}
          <g class="footer-scene__cun-dots">
            {strokes.mountain.dots.map(({ cx, cy, rx, ry, rotate }) => (
              <ellipse cx={cx} cy={cy} rx={rx} ry={ry} transform={`rotate(${rotate} ${cx} ${cy})`} />
            ))}
          </g>
        </g>
      </g>

      <ellipse class="footer-scene__mist footer-scene__mist--low" cx="420" cy="318" rx="440" ry="22" fill="url(#footer-mist)" />

      <g class="footer-scene__layer" style="--d: 4">
        <g class="footer-scene__glint">
          {strokes.water.glints.map((d, index) => <path style={`--i: ${index}`} d={d} />)}
        </g>
      </g>

      <g class="footer-scene__layer" style="--d: 3">
        <rect class="footer-scene__surface" x="0" y="338" width="1200" height="82" fill="url(#footer-water)" />
        <path class="footer-scene__horizon" d={strokes.water.horizon} />
        <g class="footer-scene__swells">
          {strokes.water.swells.map((d, index) => <path class="footer-scene__swell" style={`--s: ${index}`} d={d} />)}
        </g>
        <g class="footer-scene__water">
          {strokes.water.touches.map((d, index) => <path style={`--i: ${index}`} d={d} />)}
        </g>
      </g>

      <g class="footer-scene__layer" style="--d: 3">
        <g class="footer-scene__voyage">
          <g class="footer-scene__bob">
            <!-- Mirrored so the sampan sails right to left: it rounds the cliff
                 headland and leaves the painting over the left edge. -->
            <g transform="scale(-1 1)">
              <path class="footer-scene__wake" d={strokes.water.wake} />
              <g class="footer-scene__surge">
                <!-- Sampan with a pilgrim poling it along: kasa hat, robe, ringed staff. -->
                <g id="footer-voyager" class="footer-scene__boat" transform="translate(0 344)">
                  <g class="footer-scene__staff">
                    <path d="M-6 12 L17 -30" />
                    <circle cx="17.7" cy="-31.6" r="1.8" />
                  </g>
                  <path d="M-32 0 Q-24 9 0 10 Q25 9 36 -4 Q12 2 -32 0 Z" />
                  <g class="footer-scene__pilgrim">
                    <path d="M-1 0 L1.5 -15 Q3 -18.5 6 -18.5 Q9 -18.5 10.2 -15 L13 0 Z" />
                    <circle cx="6" cy="-20.6" r="2.4" />
                    <path d="M-4.5 -20.4 L6 -27.6 L16.5 -20.4 Q6 -22 -4.5 -20.4 Z" />
                  </g>
                </g>
                <use href="#footer-voyager" class="footer-scene__boat-reflection" transform="translate(0 708) scale(1 -1)" />
              </g>
            </g>
          </g>
        </g>
      </g>

      <ellipse class="footer-scene__mist footer-scene__mist--water" cx="300" cy="352" rx="300" ry="10" fill="url(#footer-mist)" />
    </svg>
    <svg
      class="footer-scene__svg footer-scene__plane footer-scene__plane--near"
      viewBox="0 0 1200 420"
      preserveAspectRatio="xMaxYMax slice"
      focusable="false"
    >
      <g class="footer-scene__layer" style="--d: 4">
        <path
          fill="url(#footer-cliff)"
          filter="url(#footer-brush)"
          d="M770 420 L774 360 Q782 332 806 306 Q830 280 862 264 Q900 246 944 240 L1040 234 Q1092 228 1130 214 Q1170 202 1220 204 L1220 420 Z"
        />
        <!-- Axe-cut facets (fu pi cun) under a tapered headland edge. -->
        <g class="footer-scene__cun footer-scene__cun--cliff" filter="url(#footer-brush)">
          {strokes.cliff.edges.map((d) => <path class="footer-scene__cun-crest" d={d} />)}
          {strokes.cliff.facets.map((d) => <path d={d} />)}
        </g>
        <ellipse class="footer-scene__mist footer-scene__mist--cliff" cx="830" cy="358" rx="130" ry="12" fill="url(#footer-mist)" />
        <g class="footer-scene__grass-tufts">
          {strokes.grass.map((d, index) => <path class="footer-scene__grass" style={`--w: ${[6, 8, 9][index]}`} d={d} />)}
        </g>
      </g>

      <g class="footer-scene__layer" style="--d: 5">
        <g class="footer-scene__pagoda" transform="translate(1020 236)" filter="url(#footer-wet-edge)">
          <g class="footer-scene__pagoda-walls">
            <rect x="-22" y="-6" width="44" height="6" />
            <rect x="-13" y="-20" width="26" height="14" />
            <rect x="-10" y="-38" width="20" height="10" />
            <rect x="-7" y="-54" width="14" height="8" />
          </g>
          <g class="footer-scene__pagoda-windows">
            <rect x="-2.4" y="-15" width="4.8" height="9" rx="2.2" />
            <rect x="-6" y="-35.5" width="2.6" height="5" rx="1.2" />
            <rect x="3.4" y="-35.5" width="2.6" height="5" rx="1.2" />
            <rect x="-1.2" y="-51.5" width="2.4" height="4" rx="1.1" />
          </g>
          <use href="#footer-roof" y="-19" />
          <use href="#footer-roof" transform="translate(0 -37) scale(0.8)" />
          <use href="#footer-roof" transform="translate(0 -53) scale(0.6)" />
          <path d="M0 -58 V-80" stroke-width="1.6" />
          <circle cx="0" cy="-66" r="1.6" />
          <circle cx="0" cy="-72" r="1.3" />
        </g>
        <ellipse class="footer-scene__mist footer-scene__mist--pagoda" cx="1020" cy="235" rx="46" ry="6" fill="url(#footer-mist)" />
      </g>

      <g class="footer-scene__layer" style="--d: 5">
        <g class="footer-scene__sway">
          <g class="footer-scene__pine" filter="url(#footer-brush)">
            <g class="footer-scene__canopy-wash" filter="url(#footer-wash-mid) url(#footer-wet-edge)">
              <ellipse cx="790" cy="179" rx="53.3" ry="14.2" />
              <ellipse cx="766" cy="203" rx="36" ry="11.4" />
              <ellipse cx="866" cy="171" rx="39.7" ry="13.3" />
              <ellipse cx="818" cy="157" rx="31" ry="11.4" />
              <ellipse cx="855" cy="201" rx="23.6" ry="8.5" />
            </g>
            <path d="M885.6 263 L882.9 256.3 L879 250.2 L875.2 244.3 L872.1 238.1 L868.3 232.5 L863.5 227.6 L859 222.5 L854.6 217.2 L849.2 212.8 L843.3 208.9 L837.5 204.5 L831.4 200.2 L824.4 196.9 L817.1 193.7 L813.9 191.9 L810.7 190.3 L807.3 189.1 L804.3 187.6 L801.5 185.5 L798.5 183.8 L795.5 182.1 L792.7 180 L790.1 177.6 L787.2 175.5 L784.2 173.3 L781.6 170.6 L778.9 167.8 L775.9 165.2 L774.1 166.8 L776.6 170 L779.4 172.8 L782.3 175.4 L784.9 178.1 L787.5 180.8 L790.4 183 L793.3 185.1 L795.9 187.6 L798.8 189.7 L802 191.3 L805.1 193.2 L808 195.5 L811.4 197.1 L814.9 198.3 L821.7 202.1 L827.8 206.2 L834 209.8 L839.7 213.6 L844.4 218.4 L849 223 L853.8 227.2 L857.9 232.1 L861 237.7 L864.6 243 L868.5 248.2 L871.2 254.3 L873.3 260.7 L876.4 267 Z" />
            <path d="M850 213.4 L848.7 208.8 L847.7 204.6 L847.5 200.3 L848.5 196.2 L849.8 192.1 L851.5 187.9 L854 183.9 L857.2 180.1 L860.6 176.3 L864.4 172.5 L863.6 171.5 L859.4 175.1 L855.6 178.8 L852.5 182.8 L849.7 186.8 L847.2 190.9 L845.5 195.4 L844.8 200 L844.4 204.7 L844.6 209.7 L846 214.6 Z" />
            <path d="M813 194.4 L809.3 196.8 L805.7 199.1 L801.8 200.8 L797.7 201.8 L793.4 202.6 L788.9 203.3 L784.3 203.3 L779.7 202.9 L774.9 202.3 L770.1 201.5 L769.9 202.5 L774.7 203.8 L779.5 204.7 L784.3 205 L789 205.2 L793.6 205.1 L798.2 204.5 L802.6 203.2 L807 201.8 L811.2 200.1 L815 197.6 Z" />
            <path d="M801.5 188.6 L802.8 185.6 L804 182.4 L805.5 179.1 L807.3 176 L809.2 172.8 L810.9 169.6 L812.8 166.5 L814.9 163.7 L816.7 160.9 L818.4 158.3 L817.6 157.7 L815.6 160.1 L813.6 162.8 L811.6 165.7 L809.5 168.7 L807.3 171.7 L805.3 174.8 L803.6 178.1 L801.7 181.2 L799.9 184.3 L798.5 187.4 Z" />
            <path d="M859.5 226.2 L860 222.4 L859.9 218.5 L859.5 214.8 L859 211 L857.9 207.5 L856.3 204.1 L854.5 200.8 L852.5 197.7 L851.5 198.3 L853.6 201.4 L855.2 204.6 L856.2 208 L857 211.5 L857.6 215 L857.6 218.5 L857.1 222.1 L856.5 225.8 Z" />
            <path d="M877.9 260.6 L876.1 262 L874.4 263.6 L872.5 265 L870.4 266.1 L868.3 267.3 L866.2 268.8 L864 270.2 L861.8 271.6 L862.2 272.4 L864.5 271 L866.8 269.9 L869.1 268.9 L871.4 267.9 L873.5 266.8 L875.7 265.8 L878.1 264.8 L880.1 263.4 Z" />
            <path d="M881.1 263.5 L883.5 264.8 L886 265.6 L888.5 266.3 L891 267.1 L893.6 267.6 L896.2 267.8 L899 268.1 L901.9 268.4 L902.1 267.6 L899.2 267.1 L896.4 266.6 L893.9 265.9 L891.5 265.2 L889.2 264.5 L887 263.4 L885 261.9 L882.9 260.5 Z" />
            <path class="footer-scene__bark" d={strokes.pine.bark} />
            <g class="footer-scene__knots"><circle cx="850" cy="213" r="1.6" /><circle cx="859.5" cy="226" r="1.3" /><circle cx="813" cy="195" r="1.4" /><circle cx="801" cy="188" r="1.1" /></g>
            {(["1", "0", "4", "2", "3"] as const).map((gust) => (
              <g class="footer-scene__pad" style={`--w: ${gust}`}>
                <path d={strokes.pine.pads[gust].body} />
                <path d={strokes.pine.pads[gust].needles} />
              </g>
            ))}
          </g>
        </g>
      </g>

      <g class="footer-scene__layer" style="--d: 4">
        <g class="footer-scene__rocks" filter="url(#footer-brush)">
          <path class="footer-scene__rock-reflection" d={strokes.rocks.reflection} />
          <path fill="url(#footer-rock)" d="M28 351 Q36 336 54 327 Q70 318 90 319 Q112 321 125 334 Q132 342 136 351 Z" />
          <path fill="url(#footer-rock)" opacity="0.7" d="M112 352 Q121 339 140 337 Q160 337 172 352 Z" />
          <path d={strokes.rocks.ink} />
          <circle cx="62" cy="324" r="1.5" /><circle cx="76" cy="319.5" r="1.2" /><circle cx="104" cy="320.5" r="1.4" /><circle cx="134" cy="337.5" r="1.1" />
          {strokes.rocks.reeds.map((d, index) => <path class="footer-scene__reed" style={`--w: ${Math.min(index, 2)}`} d={d} />)}
        </g>
      </g>

      <!-- The painter's seal, stamped last: 心 (mind) carved white into the red. -->
      <g class="footer-scene__layer" style="--d: 7">
        <g class="footer-scene__seal" transform="translate(176 222) scale(1.2)" filter="url(#footer-brush)">
          <rect x="-6" y="-7" width="12" height="14" rx="1" />
          <path d="M-3.8 -1.4 l-1 2.6 M-2.6 -2.8 q-0.4 4.8 2.6 4.8 q2.6 0 3.2 -1.8 M-0.8 -4.6 l1.4 1.6 M2.6 -3.4 l1.6 2" />
        </g>
      </g>
    </svg>
    <svg
      class="footer-scene__svg footer-scene__plane footer-scene__plane--grain"
      viewBox="0 0 1200 420"
      preserveAspectRatio="xMaxYMax slice"
      focusable="false"
    >
      <rect width="1200" height="420" filter="url(#footer-grain)" />
    </svg>
  </div>
</div>

<script is:inline>
  const initFooterScene = () => {
    const scene = document.querySelector('[data-footer-scene]');
    if (!scene || scene.dataset.footerSceneInit === 'true') return;
    scene.dataset.footerSceneInit = 'true';
    const reducedMotion = globalThis.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

    // Pointer parallax: the planes part slightly as the pointer crosses the footer.
    const footer = scene.closest('footer');
    const finePointer = globalThis.matchMedia?.('(hover: hover) and (pointer: fine)').matches;
    if (footer && finePointer && !reducedMotion) {
      let frame = 0;
      footer.addEventListener('pointermove', (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const box = footer.getBoundingClientRect();
          scene.style.setProperty('--mx', (((event.clientX - box.left) / box.width) * 2 - 1).toFixed(3));
          scene.style.setProperty('--my', (((event.clientY - box.top) / box.height) * 2 - 1).toFixed(3));
        });
      });
      footer.addEventListener('pointerleave', () => {
        scene.style.setProperty('--mx', '0');
        scene.style.setProperty('--my', '0');
      });
    }

    if (!('IntersectionObserver' in globalThis)) {
      scene.classList.add('is-awake');
      return;
    }

    // The painting inks itself in once per visit; later pages show it finished.
    const PAINTED_KEY = 'footer-scene-painted';
    let painted = true;
    try {
      painted = sessionStorage.getItem(PAINTED_KEY) === 'true';
    } catch {}
    if (!painted && !reducedMotion) scene.classList.add('is-inking');

    const observer = new IntersectionObserver(([entry]) => {
      scene.classList.toggle('is-awake', entry.isIntersecting);
      if (!entry.isIntersecting || !scene.classList.contains('is-inking')) return;
      if (scene.classList.contains('is-painted')) return;
      requestAnimationFrame(() => scene.classList.add('is-painted'));
      try {
        sessionStorage.setItem(PAINTED_KEY, 'true');
      } catch {}
    }, { threshold: 0.35 });
    observer.observe(scene);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  };
  initFooterScene();
  document.addEventListener('astro:page-load', initFooterScene);
</script>
