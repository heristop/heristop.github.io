# Cloudflare Web Analytics — the only tracker this site carries. Cookieless: nothing is written on
# the visitor's device, which is why no consent bar is rendered anywhere. It collects page views and
# nothing else; the vendor exposes no event API. Unset, the site ships no analytics tag at all.
CLOUDFLARE_TOKEN=

# GutenKu server behind the daily haiku card (GET ${PUBLIC_GUTENKU_API}/api/daily-haiku). Unset, it
# reads https://gutenku.xyz; point it at http://localhost:4000 to try a local GutenKu server. When the
# API misses (404, timeout, error), the card falls back to the raw files in heristop/gutenku.
PUBLIC_GUTENKU_API=
