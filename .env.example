# Self-hosted Umami. Setting both switches analytics to Umami: the build renders its cookieless tag
# instead of the Google Analytics snippet, and the consent bar and the footer's "Cookie Settings"
# shortcut are not rendered at all — the tracker sets no cookie and stores no visitor identifier, so
# there is nothing to consent to. Takes precedence over the GA property in src/analytics.ts, which
# is then ignored rather than sent in parallel.
UMAMI_SRC=
UMAMI_WEBSITE_ID=
# Only when the collect API answers on another origin than the script.
UMAMI_HOST_URL=
