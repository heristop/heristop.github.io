# Self-hosted Umami. Setting both switches analytics to Umami: the build renders its cookieless tag
# instead of the Google Analytics snippet, and the consent bar and the footer's "Cookie Settings"
# shortcut are not rendered at all — the tracker sets no cookie and writes no identifier on the
# visitor's device, which is what the bar asks about (it still derives a pseudonymous visitor hash
# server-side). Takes precedence over the GA property in src/analytics.ts, which is then ignored
# rather than sent in parallel.
UMAMI_SRC=
UMAMI_WEBSITE_ID=
# Only when the collect API answers on another origin than the script.
UMAMI_HOST_URL=

# Cloudflare Web Analytics. Cookieless like Umami, so the consent bar is not rendered under it
# either, and lighter: a token, no instance to host. It collects page views and nothing else — no
# event API. Ranks behind Umami and ahead of Google Analytics when several are set.
CLOUDFLARE_TOKEN=
