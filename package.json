{
  "name": "zazencode",
  "type": "module",
  "version": "2.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm check:packages && astro check && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky",
    "lint": "oxlint src packages/*/src --type-aware -c oxlintrc.json",
    "lint:fix": "oxlint --fix src packages/*/src -c oxlintrc.json",
    "lint:strict": "oxlint src packages/*/src --deny-warnings --type-aware -c oxlintrc.json",
    "style:lint": "stylelint 'src/**/*.{css,scss}' 'packages/*/src/**/*.{css,scss}'",
    "md:lint": "markdownlint src/content/**/*.md --ignore node_modules --disable=MD013 --disable=MD033",
    "md:check": "markdown-link-check src/content/**/*.md --ignore node_modules -c .markdown-link-check.json",
    "format": "oxfmt 'src/**/*.ts' 'packages/*/src/**/*.{ts,tsx}'",
    "format:check": "oxfmt --check 'src/**/*.ts' 'packages/*/src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:garden:coverage": "pnpm --filter @zazencode/path-of-stones test:coverage",
    "benchmark:garden": "pnpm --filter @zazencode/path-of-stones benchmark",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ui": "playwright test --ui",
    "test:visual:headed": "playwright test --headed",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:images:dry": "node scripts/optimize-images.mjs --dry-run",
    "generate:art": "pnpm --filter @zazencode/path-of-stones generate:art",
    "fetch:github": "pnpm --filter @zazencode/path-of-stones fetch:github",
    "tune:garden": "pnpm --filter @zazencode/path-of-stones tune",
    "evaluate:garden": "pnpm --filter @zazencode/path-of-stones evaluate",
    "check:packages": "pnpm -r --if-present check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/react": "^6.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.4",
    "astro-icon": "^1.2.0",
    "katex": "^0.18.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype": "^13.0.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "@zazencode/path-of-stones": "workspace:*",
    "@zazencode/ui": "workspace:*",
    "@chenglou/pretext": "^0.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "markdown-link-check": "3.15.0",
    "markdownlint-cli": "^0.49.1",
    "oxfmt": "latest",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "rehype-mermaid": "^3.0.0",
    "sass": "^1.103.1",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^4.1.11"
  },
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22.18.0"
  }
}
